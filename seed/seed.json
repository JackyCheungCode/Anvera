{
  "$schema": "https://emdashcms.com/seed.schema.json",
  "version": "1",
  "meta": {
    "name": "ANVERA",
    "description": "ANVERA forged wheel brand content model and development catalogue",
    "author": "ANVERA"
  },
  "settings": {
    "title": "Anvera",
    "tagline": "A modern content platform"
  },
  "collections": [
    {
      "slug": "posts",
      "label": "Posts",
      "labelSingular": "Post",
      "urlPattern": "/posts/{slug}",
      "supports": [
        "drafts",
        "revisions",
        "preview",
        "scheduling",
        "search",
        "seo"
      ],
      "fields": [
        {
          "slug": "title",
          "label": "Title",
          "type": "string",
          "required": true,
          "searchable": true
        },
        {
          "slug": "featured_image",
          "label": "Featured Image",
          "type": "image"
        },
        {
          "slug": "content",
          "label": "Content",
          "type": "portableText",
          "searchable": true
        },
        {
          "slug": "excerpt",
          "label": "Excerpt",
          "type": "text"
        }
      ]
    },
    {
      "slug": "pages",
      "label": "Pages",
      "labelSingular": "Page",
      "urlPattern": "/{slug}",
      "supports": [
        "drafts",
        "revisions",
        "preview",
        "search",
        "seo"
      ],
      "fields": [
        {
          "slug": "title",
          "label": "Title",
          "type": "string",
          "required": true,
          "searchable": true
        },
        {
          "slug": "content",
          "label": "Content",
          "type": "portableText",
          "searchable": true
        }
      ]
    },
    {
      "slug": "wheel_products",
      "label": "Wheel Products",
      "labelSingular": "Wheel Product",
      "description": "ANVERA forged wheel designs and their technical and marketing content.",
      "supports": [
        "drafts",
        "revisions",
        "preview",
        "search",
        "seo"
      ],
      "urlPattern": "/wheels/models/{slug}",
      "titleField": "title",
      "admin": {
        "listColumns": [
          "model_code",
          "construction_type",
          "family",
          "display_order"
        ]
      },
      "fields": [
        {
          "slug": "title",
          "label": "Product Name",
          "type": "string",
          "required": true,
          "searchable": true
        },
        {
          "slug": "model_code",
          "label": "Model Code",
          "type": "string",
          "required": true,
          "unique": true,
          "indexed": true
        },
        {
          "slug": "family",
          "label": "Collection / Family",
          "type": "string"
        },
        {
          "slug": "construction_type",
          "label": "Construction Type",
          "type": "select",
          "validation": {
            "options": [
              "monoblock",
              "two_piece",
              "three_piece"
            ]
          }
        },
        {
          "slug": "material",
          "label": "Material",
          "type": "text"
        },
        {
          "slug": "manufacturing_process",
          "label": "Manufacturing Process",
          "type": "text"
        },
        {
          "slug": "design_style",
          "label": "Design Language",
          "type": "text"
        },
        {
          "slug": "short_description",
          "label": "Short Description",
          "type": "text",
          "searchable": true
        },
        {
          "slug": "design_story",
          "label": "Design Story",
          "type": "portableText"
        },
        {
          "slug": "hero_image",
          "label": "Hero Image",
          "type": "image"
        },
        {
          "slug": "gallery_images",
          "label": "Product Gallery",
          "type": "json"
        },
        {
          "slug": "diameter_options",
          "label": "Diameter Options",
          "type": "json"
        },
        {
          "slug": "width_options",
          "label": "Width Options",
          "type": "json"
        },
        {
          "slug": "pcd_options",
          "label": "PCD Options",
          "type": "json"
        },
        {
          "slug": "offset_range",
          "label": "Offset Range",
          "type": "text"
        },
        {
          "slug": "centre_bore_options",
          "label": "Centre Bore Options",
          "type": "json"
        },
        {
          "slug": "finish_options",
          "label": "Finish Directions",
          "type": "json"
        },
        {
          "slug": "intended_use",
          "label": "Intended Use",
          "type": "json"
        },
        {
          "slug": "technical_disclaimer",
          "label": "Technical Disclaimer",
          "type": "text"
        },
        {
          "slug": "development_sample",
          "label": "Development Sample",
          "type": "boolean",
          "defaultValue": true
        },
        {
          "slug": "display_order",
          "label": "Display Order",
          "type": "integer"
        },
        {
          "slug": "available_finishes",
          "label": "Available Finishes",
          "type": "reference",
          "validation": {
            "relation": "wheel_product_finishes"
          }
        }
      ]
    },
    {
      "slug": "wheel_finishes",
      "label": "Wheel Finishes",
      "labelSingular": "Wheel Finish",
      "description": "Finish options, codes, swatches and sample media.",
      "supports": [
        "drafts",
        "revisions",
        "search"
      ],
      "routable": false,
      "fields": [
        {
          "slug": "title",
          "label": "Finish Name",
          "type": "string",
          "required": true
        },
        {
          "slug": "finish_code",
          "label": "Finish Code",
          "type": "string",
          "unique": true
        },
        {
          "slug": "finish_description",
          "label": "Description",
          "type": "text"
        },
        {
          "slug": "swatch_hex",
          "label": "Swatch Colour",
          "type": "string"
        },
        {
          "slug": "sample_image",
          "label": "Sample Image",
          "type": "image"
        },
        {
          "slug": "active",
          "label": "Active",
          "type": "boolean",
          "defaultValue": true
        },
        {
          "slug": "display_order",
          "label": "Display Order",
          "type": "integer"
        }
      ]
    },
    {
      "slug": "wheel_fitments",
      "label": "Wheel Fitments",
      "labelSingular": "Wheel Fitment",
      "description": "Vehicle-specific fitment records. Only engineering-verified records may be published.",
      "supports": [
        "drafts",
        "revisions",
        "search"
      ],
      "routable": false,
      "fields": [
        {
          "slug": "vehicle_make",
          "label": "Vehicle Make",
          "type": "string",
          "required": true,
          "indexed": true
        },
        {
          "slug": "vehicle_model",
          "label": "Vehicle Model",
          "type": "string",
          "required": true,
          "indexed": true
        },
        {
          "slug": "model_year_from",
          "label": "Year From",
          "type": "integer"
        },
        {
          "slug": "model_year_to",
          "label": "Year To",
          "type": "integer"
        },
        {
          "slug": "front_spec",
          "label": "Front Specification",
          "type": "json"
        },
        {
          "slug": "rear_spec",
          "label": "Rear Specification",
          "type": "json"
        },
        {
          "slug": "verification_status",
          "label": "Verification Status",
          "type": "select",
          "validation": {
            "options": [
              "unverified",
              "under_review",
              "verified",
              "rejected"
            ]
          }
        },
        {
          "slug": "verified_at",
          "label": "Verified At",
          "type": "datetime"
        },
        {
          "slug": "products",
          "label": "Compatible Wheel Products",
          "type": "reference",
          "validation": {
            "relation": "wheel_fitment_products"
          }
        }
      ]
    }
  ],
  "taxonomies": [
    {
      "name": "category",
      "label": "Categories",
      "labelSingular": "Category",
      "hierarchical": true,
      "collections": [
        "posts"
      ],
      "terms": [
        {
          "slug": "general",
          "label": "General"
        },
        {
          "slug": "updates",
          "label": "Updates"
        }
      ]
    },
    {
      "name": "tag",
      "label": "Tags",
      "labelSingular": "Tag",
      "hierarchical": false,
      "collections": [
        "posts"
      ],
      "terms": [
        {
          "slug": "starter",
          "label": "Starter"
        },
        {
          "slug": "example",
          "label": "Example"
        }
      ]
    }
  ],
  "menus": [
    {
      "name": "primary",
      "label": "Primary Navigation",
      "items": [
        {
          "type": "custom",
          "label": "Home",
          "url": "/"
        },
        {
          "type": "custom",
          "label": "Posts",
          "url": "/posts"
        },
        {
          "type": "custom",
          "label": "About",
          "url": "/about"
        }
      ]
    }
  ],
  "widgetAreas": [
    {
      "name": "sidebar",
      "label": "Sidebar",
      "description": "Sidebar widget area",
      "widgets": [
        {
          "type": "component",
          "componentId": "core:search",
          "title": "Search"
