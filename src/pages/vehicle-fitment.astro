---
import Base from "../layouts/Base.astro";
import Button from "../components/ui/Button.astro";
import VehicleFitmentFinder from "../components/VehicleFitmentFinder.astro";
import { getEmDashCollection, getEmDashEntry } from "emdash";
const { entries: wheelEntries = [], cacheHint } = await getEmDashCollection("wheel_products", { status: "published", limit: 100, orderBy: { display_order: "asc" } }).catch(() => ({ entries: [], cacheHint: null }));
if (cacheHint && Astro.cache?.enabled) Astro.cache.set(cacheHint);
const { entries: fitmentIndex = [] } = await getEmDashCollection("wheel_fitments", { status: "published", limit: 100 }).catch(() => ({ entries: [] }));
const fitmentResults = await Promise.all(fitmentIndex.map((fitment: any) => getEmDashEntry("wheel_fitments", fitment.id, { references: { products: true } }).catch(() => ({ entry: null }))));
const verifiedFitments = fitmentResults.map((result: any) => result.entry).filter((fitment: any) => fitment?.data?.verification_status === "verified");
const productDetails = await Promise.all(wheelEntries.map((entry: any) => getEmDashEntry("wheel_products", entry.id, { references: { available_finishes: true } }).catch(() => ({ entry: null }))));
const products = wheelEntries.map((entry: any) => {
  const data = entry.data ?? {};
  const detail = productDetails.find((result: any) => result.entry?.id === entry.id)?.entry;
  const availableFinishes = (detail?.references?.available_finishes?.entries ?? []).filter((finish: any) => finish.data?.active !== false).map((finish: any) => String(finish.data?.title ?? finish.data?.finish_code ?? "")).filter(Boolean);
  const specs = data.fitment_specs ?? data.wheel_specs ?? data.specifications ?? {};
  const linkedFitments = verifiedFitments.filter((fitment: any) => (fitment.references?.products?.entries ?? []).some((linked: any) => linked.id === entry.id)).map((fitment: any) => ({
    front: fitment.data?.front_spec ?? {},
    rear: fitment.data?.rear_spec ?? {},
    vehicleMake: String(fitment.data?.vehicle_make ?? ""),
    vehicleModel: String(fitment.data?.vehicle_model ?? ""),
    modelYearFrom: fitment.data?.model_year_from ?? null,
    modelYearTo: fitment.data?.model_year_to ?? null
  }));
  return {
    id: entry.id,
    title: String(data.title ?? "ANVERA forged wheel"),
    modelCode: String(data.model_code ?? ""),
    construction: String(data.construction_type ?? ""),
    finish: String(data.finish_name ?? data.finish ?? availableFinishes[0] ?? ""),
    finishes: availableFinishes,
    specs,
    verifiedFitments: linkedFitments
  };
});
---
<Base title="Find Wheels for Your Vehicle" description="Compare factory and aftermarket wheel fitments, then explore ANVERA forged wheel designs matched to your vehicle specification.">
  <section class="vehicle-finder-hero">
    <div class="vehicle-finder-hero-inner">
      <p class="eyebrow">ANVERA / ENGINEERED AROUND YOUR VEHICLE</p>
      <h1>Precision begins<br /><span>with fitment.</span></h1>
      <p>Start with your vehicle. Compare original equipment and alternative fitments, then discover ANVERA forged wheel designs around your selected specification.</p>
    </div>
  </section>
  <VehicleFitmentFinder products={products} />
  <section class="vehicle-finder-next">
    <div><p class="section-kicker">Beyond factory fitment</p><h2>Made to fit.<br />Made to be yours.</h2><p>Factory specifications are the starting point. Our team will review the complete vehicle configuration before confirming a bespoke wheel specification.</p></div>
    <Button href="/custom-inquiry" variant="primary">Discuss your configuration <span aria-hidden="true">↗</span></Button>
  </section>
</Base>
