h-child(3):after{animation-delay:.4s}.manufacturing-node:nth-child(4):after{animation-delay:.6s}.manufacturing-node:nth-child(5):after{animation-delay:.8s}.manufacturing-node:nth-child(6):after{animation-delay:1s}.manufacturing-node:nth-child(7):after{animation-delay:1.2s}.manufacturing-node i{font-style:normal;color:#78a9ff;font-size:11px}.manufacturing-node b{font-size:13px;line-height:1.4}.manufacturing-node p{font-size:10px;color:#9da5ad;line-height:1.5}.manufacturing-node strong{font-size:11px;margin-top:auto}.delivery-address{grid-column:span 2}.route-estimate{margin-top:30px;background:#17191c;padding:24px}.route-heading{display:flex;justify-content:space-between;align-items:center}.route-heading h3{font-size:24px;margin:8px 0}.route-stages{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin:22px 0}.route-stage{padding:16px;background:#202328;display:grid;gap:7px}.route-dot{width:26px;height:26px;display:grid;place-items:center;background:#0f62fe;font-size:10px}.route-stage b{font-size:12px}.route-stage small,.route-stage em{font-size:10px;color:#9da5ad;font-style:normal}.route-map-placeholder{height:180px;background:radial-gradient(ellipse at 30% 50%,#263541,#15191e 68%);display:flex;align-items:center;justify-content:space-around;position:relative;overflow:hidden}.map-pin{z-index:1;background:#0f62fe;padding:8px 10px;font-size:9px;letter-spacing:.08em}.map-route-line{height:2px;background:repeating-linear-gradient(90deg,#78a9ff 0 9px,transparent 9px 16px);width:55%;position:absolute}.map-truck{z-index:2;background:#0b0c0e;color:#78a9ff;padding:8px 12px;animation:truckMove 4s ease-in-out infinite alternate}.route-map-placeholder p{position:absolute;bottom:8px;left:12px;right:12px;text-align:center;font-size:10px;color:#9da5ad}.arrival-estimate{display:grid;gap:8px;padding:20px 0 0}.arrival-estimate span{font-size:10px;letter-spacing:.12em;color:#9da5ad}.arrival-estimate strong{font-size:25px}.arrival-estimate small{font-size:11px;color:#9da5ad}.