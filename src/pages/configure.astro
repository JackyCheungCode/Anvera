---
import Base from "../layouts/Base.astro";
import { getEmDashCollection } from "emdash";
import { Image } from "emdash/ui";
import { wheelDevelopmentProducts } from "../data/wheel-products";

const turnstileSiteKey = "0x4AAAAAAF-OqItFi-JleERp";

const { entries: wheelEntries = [] } = await getEmDashCollection("wheel_products", { status: "published", limit: 100, orderBy: { display_order: "asc" } }).catch(() => ({ entries: [] }));
const products = wheelEntries.length ? wheelEntries.map((entry: any) => ({
  slug: entry.id,
  title: String(entry.data?.title ?? "ANVERA forged wheel"),
  code: String(entry.data?.model_code ?? ""),
  construction: String(entry.data?.construction_type ?? "").replaceAll("_", "-"),
  description: String(entry.data?.short_description ?? ""),
  diameter: Array.isArray(entry.data?.diameter_options) ? entry.data.diameter_options.join(" / ") : "Vehicle-specific sizing",
  image: entry.data?.hero_image ?? null,
})) : wheelDevelopmentProducts.map((product) => ({
  slug: product.slug, title: product.title, code: product.modelCode,
  construction: product.constructionType.replaceAll("_", "-"),
  description: product.shortDescription, diameter: product.diameterOptions.join(" / "), image: null,
}));
---
<Base title="Configure Your ANVERA Wheels" description="Configure ANVERA forged wheels around your vehicle, engineering requirements and delivery destination.">
  <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
  <section class="studio-shell" id="configuration-studio">
    <header class="studio-heading">
      <div>
        <p class="studio-eyebrow">ANVERA / CUSTOMER CONFIGURATION STUDIO</p>
        <h1>Configure your<br /><span>forged wheels.</span></h1>
        <p class="studio-intro">A considered process from wheel design to delivery. Your configuration reference is created as soon as you begin.</p>
      </div>
      <aside class="reference-panel">
        <span>CONFIGURATION REFERENCE</span>
        <strong id="reference-code">Creating reference…</strong>
        <small id="reference-state">Creating secure server draft…</small>
      </aside>
    </header>

    <nav class="studio-progress" aria-label="Configuration progress">
      <div class="progress-track"><span id="progress-fill"></span></div>
      <ol id="progress-steps">
        <li class="is-current" data-step-label="1"><span>01</span><b>Design</b></li>
        <li data-step-label="2"><span>02</span><b>Vehicle</b></li>
        <li data-step-label="3"><span>03</span><b>Specifications</b></li>
        <li data-step-label="4"><span>04</span><b>Manufacturing</b></li>
        <li data-step-label="5"><span>05</span><b>Delivery</b></li>
        <li data-step-label="6"><span>06</span><b>Confirmation</b></li>
        <li data-step-label="7"><span>07</span><b>Complete</b></li>
      </ol>
      <div class="progress-caption"><span id="progress-current">STEP 01 / 07</span><span id="progress-title">Select a wheel design</span></div>
    </nav>

    <main class="studio-content">
      <section class="studio-step is-active" data-step="1">
        <div class="step-heading"><div><p class="step-kicker">01 / DESIGN SELECTION</p><h2>Choose your wheel design.</h2><p>Start with a design direction. Every selection can be refined later.</p></div><span class="step-index">01—07</span></div>
        <div class="design-grid" id="design-grid">
          {products.map((product, index) => (
            <button class="design-card" type="button" data-product={product.slug} aria-pressed="false">
              <span class="design-art">{product.image ? <Image image={product.image} width={900} height={675} /> : <span class:list={["wheel-render", `design-wheel-${index % 5}`]}></span>}<i>{String(index + 1).padStart(2, "0")}</i></span>
              <span class="design-meta"><b>{product.title}</b><small>{product.code} / {product.construction.toUpperCase()}</small><small>{product.diameter || "Vehicle-specific sizing"}</small></span>
              <span class="design-check" aria-hidden="true">✓</span>
            </button>
          ))}
        </div>
      </section>

      <section class="studio-step" data-step="2" hidden>
        <div class="step-heading"><div><p class="step-kicker">02 / VEHICLE SELECTION</p><h2>Tell us what you drive.</h2><p>Choose your market, vehicle and model year. Vehicle imagery appears when a suitable image is available.</p></div><span class="step-index">02—07</span></div>
        <div class="vehicle-filter-row">
          <label>Market region <div class="carbon-dropdown" data-carbon-dropdown><input type="hidden" id="vehicle-region" value="sam" /><button type="button" class="carbon-dropdown-trigger" aria-haspopup="listbox" aria-expanded="false"><span data-dropdown-label>Southeast Asia</span><span aria-hidden="true">⌄</span></button><div class="carbon-dropdown-menu" role="listbox" hidden><button type="button" role="option" data-value="sam" aria-selected="false">Southeast Asia</button><button type="button" role="option" data-value="usdm" aria-selected="false">USA & North America</button><button type="button" role="option" data-value="eudm" aria-selected="false">Europe</button><button type="button" role="option" data-value="jdm" aria-selected="false">Japan</button><button type="button" role="option" data-value="chdm" aria-selected="false">China</button><button type="button" role="option" data-value="audm" aria-selected="false">Oceania</button></div></div></label>
          <label>Manufacturer <div class="carbon-dropdown" data-carbon-dropdown><input type="hidden" id="vehicle-make" value="" /><button type="button" class="carbon-dropdown-trigger" aria-haspopup="listbox" aria-expanded="false"><span data-dropdown-label>Loading manufacturers…</span><span aria-hidden="true">⌄</span></button><div class="carbon-dropdown-menu" role="listbox" hidden></div></div></label>
          <label>Model <div class="carbon-dropdown" data-carbon-dropdown><input type="hidden" id="vehicle-model" value="" /><button type="button" class="carbon-dropdown-trigger" aria-haspopup="listbox" aria-expanded="false"><span data-dropdown-label>Select manufacturer first</span><span aria-hidden="true">⌄</span></button><div class="carbon-dropdown-menu" role="listbox" hidden></div></div></label>
          <label>Model year <div class="carbon-dropdown" data-carbon-dropdown><input type="hidden" id="vehicle-year" value="" /><button type="button" class="carbon-dropdown-trigger" aria-haspopup="listbox" aria-expanded="false"><span data-dropdown-label>Select model first</span><span aria-hidden="true">⌄</span></button><div class="carbon-dropdown-menu" role="listbox" hidden></div></div></label>
          <label>Generation <div class="carbon-dropdown" data-carbon-dropdown><input type="hidden" id="vehicle-generation" value="" /><button type="button" class="carbon-dropdown-trigger" aria-haspopup="listbox" aria-expanded="false"><span data-dropdown-label>Optional generation</span><span aria-hidden="true">⌄</span></button><div class="carbon-dropdown-menu" role="listbox" hidden></div></div></label>
          <label>Modification / trim <div class="carbon-dropdown" data-carbon-dropdown><input type="hidden" id="vehicle-trim" value="" /><button type="button" class="carbon-dropdown-trigger" aria-haspopup="listbox" aria-expanded="false"><span data-dropdown-label>Optional trim</span><span aria-hidden="true">⌄</span></button><div class="carbon-dropdown-menu" role="listbox" hidden></div></div></label>
        </div>
        <div class="vehicle-preview" id="vehicle-preview">
          <div class="vehicle-preview-art"><span class="vehicle-silhouette">ANVERA</span></div>
          <div><p class="step-kicker">YOUR VEHICLE</p><h3 id="vehicle-preview-title">Vehicle not selected</h3><p id="vehicle-preview-copy">Select the manufacturer, model and year above. The vehicle catalogue is loaded from the existing Wheel-Size integration.</p></div>
        </div>
        <p class="studio-note" id="vehicle-status" role="status">Loading vehicle catalogue…</p>
      </section>

      <section class="studio-step" data-step="3" hidden>
        <div class="step-heading"><div><p class="step-kicker">03 / SPECIFICATION</p><h2>Choose your specification path.</h2><p>Factory and upgrade references are starting points. Final fitment requires engineering verification.</p></div><span class="step-index">03—07</span></div>
        <div class="spec-path-grid">
          <button class="spec-path" type="button" data-spec-path="oem" aria-pressed="false"><span class="path-label">01 / FACTORY REFERENCE</span><b>OEM specification</b><p>Review original equipment dimensions for your selected vehicle.</p><span class="path-action">Use factory reference ↗</span></button>
          <button class="spec-path" type="button" data-spec-path="upgrade" aria-pressed="false"><span class="path-label">02 / ANVERA RECOMMENDATION</span><b>Upgrade reference</b><p>Explore a considered upgrade direction for further engineering review.</p><span class="path-action">Explore upgrade ↗</span></button>
          <button class="spec-path spec-path--custom" type="button" data-spec-path="custom" aria-pressed="false"><span class="path-label">03 / YOUR OWN BRIEF</span><b>Custom specification</b><p>Submit your own front and rear dimensions for an engineering review.</p><span class="path-action">Submit custom brief ↗</span></button>
        </div>
        <div class="spec-detail" id="spec-detail" hidden>
          <div class="spec-detail-heading"><div><p class="step-kicker" id="spec-detail-kicker">REFERENCE SPECIFICATION</p><h3 id="spec-detail-title">Specification overview</h3></div><span class="review-status">ENGINEERING REVIEW REQUIRED</span></div>
          <p class="fitment-status" id="fitment-status" role="status">Select a reference path to retrieve the vehicle's factory or alternative fitment records.</p>
          <div class="fitment-options" id="fitment-options" hidden></div>
          <div class="spec-columns" id="spec-reference">
            <div><b>FRONT</b><dl><dt>Diameter</dt><dd id="front-diameter">—</dd><dt>Width</dt><dd id="front-width">—</dd><dt>PCD</dt><dd id="front-pcd">—</dd><dt>Offset</dt><dd id="front-offset">—</dd><dt>Centre bore</dt><dd id="front-bore">—</dd></dl></div>
            <div><b>REAR</b><dl><dt>Diameter</dt><dd id="rear-diameter">—</dd><dt>Width</dt><dd id="rear-width">—</dd><dt>PCD</dt><dd id="rear-pcd">—</dd><dt>Offset</dt><dd id="rear-offset">—</dd><dt>Centre bore</dt><dd id="rear-bore">—</dd></dl></div>
          </div>
          <div class="custom-spec-fields" id="custom-spec-fields" hidden>
            <label>Front wheel specification <input id="custom-front" placeholder="e.g. 20 × 9.0J / ET25 / 5×112" /></label>
            <label>Rear wheel specification <input id="custom-rear" placeholder="e.g. 20 × 10.5J / ET35 / 5×112" /></label>
            <label>Additional engineering notes <textarea id="custom-notes" rows="3" placeholder="Brake package, suspension, tyre size or other requirements…"></textarea></label>
            <label class="upload-field">Vehicle / wheel reference photos <input id="custom-files" type="file" accept="image/*,.pdf" multiple /></label>
            <p class="custom-response">Our engineering team will review your custom specifications and respond within <strong>1 business day</strong> after submission.</p>
          </div>
        </div>
      </section>

      <section class="studio-step" data-step="4" hidden>
        <div class="step-heading"><div><p class="step-kicker">04 / MANUFACTURING</p><h2>From forged billet to finished wheel.</h2><p>An initial manufacturing estimate based on a typical bespoke forged wheel project.</p></div><span class="step-index">04—07</span></div>
        <div class="manufacturing-summary"><div><span>ESTIMATED MANUFACTURING TIME</span><strong>15–27 <small>working days</small></strong><p>Planning estimate only. Final lead time is confirmed after engineering review and order acceptance.</p></div><div class="manufacturing-wheel"><span class="wheel-render"></span></div></div>
        <div class="manufacturing-track" id="manufacturing-track">
          <article class="manufacturing-node"><i>01</i><div><b>Engineering confirmation</b><p>Review vehicle, dimensions and brake clearance</p></div><strong>1–3 days</strong></article>
          <article class="manufacturing-node"><i>02</i><div><b>Material preparation</b><p>Forging billet preparation and material traceability</p></div><strong>2–4 days</strong></article>
          <article class="manufacturing-node"><i>03</i><div><b>Aluminium forging</b><p>Controlled forging and blank preparation</p></div><strong>2–3 days</strong></article>
          <article class="manufacturing-node"><i>04</i><div><b>CNC precision machining</b><p>Spoke, barrel, hub and mounting geometry</p></div><strong>4–7 days</strong></article>
          <article class="manufacturing-node"><i>05</i><div><b>Surface finishing</b><p>Preparation, coating and final finish</p></div><strong>3–5 days</strong></article>
          <article class="manufacturing-node"><i>06</i><div><b>Assembly & quality inspection</b><p>Dimensional, runout and appearance checks</p></div><strong>2–3 days</strong></article>
          <article class="manufacturing-node"><i>07</i><div><b>Packaging & dispatch readiness</b><p>Protective packing and export preparation</p></div><strong>1–2 days</strong></article>
        </div>
        <p class="studio-note">The animated sequence illustrates the planned production stages; it does not represent live factory progress. Some operations may overlap depending on the final construction and factory schedule.</p>
      </section>

      <section class="studio-step" data-step="5" hidden>
        <div class="step-heading"><div><p class="step-kicker">05 / DELIVERY & LOGISTICS</p><h2>Where should we deliver?</h2><p>Choose the Incoterm and destination. The route and arrival window will be estimated from the destination address.</p></div><span class="step-index">05—07</span></div>
        <div class="delivery-form-grid">
          <label>Delivery term <div class="carbon-dropdown" data-carbon-dropdown><input type="hidden" id="delivery-term" value="FOB" /><button type="button" class="carbon-dropdown-trigger" aria-haspopup="listbox" aria-expanded="false"><span data-dropdown-label>FOB — Free On Board</span><span aria-hidden="true">⌄</span></button><div class="carbon-dropdown-menu" role="listbox" hidden><button type="button" role="option" data-value="FOB" aria-selected="false">FOB — Free On Board</button><button type="button" role="option" data-value="EXW" aria-selected="false">EXW — Ex Works</button><button type="button" role="option" data-value="FCA" aria-selected="false">FCA — Free Carrier</button><button type="button" role="option" data-value="CFR" aria-selected="false">CFR — Cost and Freight</button><button type="button" role="option" data-value="CIF" aria-selected="false">CIF — Cost, Insurance and Freight</button><button type="button" role="option" data-value="CPT" aria-selected="false">CPT — Carriage Paid To</button><button type="button" role="option" data-value="CIP" aria-selected="false">CIP — Carriage and Insurance Paid To</button><button type="button" role="option" data-value="DAP" aria-selected="false">DAP — Delivered at Place</button><button type="button" role="option" data-value="DPU" aria-selected="false">DPU — Delivered at Place Unloaded</button><button type="button" role="option" data-value="DDP" aria-selected="false">DDP — Delivered Duty Paid</button></div></div></label>
          <label>Transport method <div class="carbon-dropdown" data-carbon-dropdown><input type="hidden" id="shipping-method" value="sea" /><button type="button" class="carbon-dropdown-trigger" aria-haspopup="listbox" aria-expanded="false"><span data-dropdown-label>Sea freight (default)</span><span aria-hidden="true">⌄</span></button><div class="carbon-dropdown-menu" role="listbox" hidden><button type="button" role="option" data-value="sea" aria-selected="false">Sea freight (default)</button><button type="button" role="option" data-value="air" aria-selected="false">Air freight (estimate required)</button></div></div></label>
          <label>Country / territory <input id="delivery-country" autocomplete="country-name" placeholder="e.g. Germany" /></label>
          <label>State / province <input id="delivery-region" autocomplete="address-level1" placeholder="State or province" /></label>
          <label>City <input id="delivery-city" autocomplete="address-level2" placeholder="City" /></label>
          <label>Postal code <input id="delivery-postal" autocomplete="postal-code" placeholder="Postal code" /></label>
          <label class="delivery-address">Street address <input id="delivery-address" autocomplete="street-address" placeholder="Street, building and unit number" /></label>
          <label>Contact name <input id="contact-name" autocomplete="name" placeholder="Full name" /></label>
          <label>Email <input id="contact-email" type="email" autocomplete="email" placeholder="name@example.com" /></label>
          <label>Phone / WhatsApp <input id="contact-phone" autocomplete="tel" placeholder="Country code + number" /></label>
        </div>
        <div class="route-estimate">
          <div class="route-heading"><div><p class="step-kicker">LOGISTICS ROUTE / PLANNING VIEW</p><h3>Chengdu → Yantian → Destination</h3></div><span class="route-tag">SEA FREIGHT DEFAULT</span></div>
          <div class="route-stages">
            <div class="route-stage"><span class="route-dot">01</span><b>Chengdu factory</b><small>Factory dispatch</small><em>1–2 days</em></div>
            <div class="route-stage"><span class="route-dot">02</span><b>Shenzhen Yantian Port</b><small>Road freight · export handling</small><em>2–4 days</em></div>
            <div class="route-stage"><span class="route-dot">03</span><b>Destination port</b><small>Ocean transit · customs</small><em id="ocean-estimate">Route required</em></div>
            <div class="route-stage"><span class="route-dot">04</span><b>Delivery address</b><small>Local transport</small><em>Route required</em></div>
          </div>
          <div class="route-map-placeholder"><span class="map-pin map-pin--start">CHENGDU</span><span class="map-route-line"></span><span class="map-truck">▰</span><span class="map-pin map-pin--port">YANTIAN PORT</span><p>Verified road, port and ocean-route mapping will be calculated after destination geocoding is connected.</p></div>
          <div class="arrival-estimate"><span>ESTIMATED TOTAL DELIVERY WINDOW</span><strong id="delivery-window">Awaiting destination details</strong><small id="delivery-window-note">Includes manufacturing estimate and indicative transport stages; customs and carrier schedules may change the arrival date.</small></div>
        </div>
        <p class="studio-note">Incoterms allocate delivery obligations, costs and risk. FOB is intended for sea or inland-waterway transport; the selected term will be explained in the confirmation document.</p>
      </section>

      <section class="studio-step" data-step="6" hidden>
        <div class="step-heading"><div><p class="step-kicker">06 / CONFIGURATION CONFIRMATION</p><h2>Review your configuration.</h2><p>Your confirmation document records the brief and planning estimates. It contains no price and is not a sales contract.</p></div><span class="step-index">06—07</span></div>
        <article class="confirmation-document" id="confirmation-document">
          <header class="document-header"><div><span>ANVERA / FORGED WHEEL ENGINEERING</span><h2>Configuration<br />Confirmation</h2></div><div class="document-reference"><small>REFERENCE</small><b id="document-reference">—</b><small>CREATED</small><b id="document-date">—</b></div></header>
          <div class="document-rule"></div>
          <section class="document-section"><span>01 / SELECTED DESIGN</span><div class="document-value"><b id="document-design">—</b><small id="document-construction">—</small></div></section>
          <section class="document-section"><span>02 / VEHICLE</span><div class="document-value"><b id="document-vehicle">—</b><small id="document-vehicle-detail">—</small></div></section>
          <section class="document-section"><span>03 / WHEEL SPECIFICATION</span><div class="document-value"><b id="document-spec-type">—</b><small id="document-spec-details">—</small><small class="document-warning">Fitment subject to ANVERA engineering verification.</small></div></section>
          <section class="document-section"><span>04 / MANUFACTURING PLAN</span><div class="document-value"><b>Estimated 15–27 working days</b><small>Seven planned production stages. Not live production tracking.</small></div></section>
          <section class="document-section"><span>05 / DELIVERY</span><div class="document-value"><b id="document-delivery">—</b><small id="document-address">—</small><small id="document-arrival">—</small></div></section>
          <section class="document-section"><span>06 / CUSTOMER CONTACT</span><div class="document-value"><b id="document-contact">—</b><small id="document-email">—</small><small id="document-phone">—</small></div></section>
          <footer class="document-footer"><b>ANVERA</b><span>CONFIGURATION RECORD · NO PRICING · SUBJECT TO REVIEW</span></footer>
        </article>
        {<div class="cf-turnstile" data-sitekey={turnstileSiteKey}></div>}
        <div class="confirmation-actions"><button class="carbon-button carbon-button--secondary" id="download-pdf" type="button">Export PDF ↓</button><button class="carbon-button carbon-button--primary" id="submit-configuration" type="button">Submit configuration ↗</button></div>
        <p class="studio-note" id="submit-status" role="status">Submitting creates a review request. ANVERA will confirm fitment, quotation and final delivery schedule separately.</p>
      </section>

      <section class="studio-step" data-step="7" hidden>
        <div class="completion-mark">✓</div>
        <p class="step-kicker">07 / CONFIGURATION PREPARED</p>
        <h2>Thank you for<br /><span>choosing ANVERA.</span></h2>
        <p class="completion-copy" id="completion-status">Your configuration has been prepared.</p>
        <div class="completion-reference"><small>YOUR REFERENCE</small><strong id="completion-reference">—</strong><span>Keep this reference for future correspondence.</span></div>
        <a class="carbon-button carbon-button--primary" id="track-configuration-link" href="/configuration/track">Track this configuration ↗</a>
        <a class="carbon-button carbon-button--secondary" href="/dealers">Explore ANVERA</a>
      </section>
    </main>

    <footer class="studio-controls" id="studio-controls">
      <button class="carbon-button carbon-button--ghost" id="previous-step" type="button" disabled>← Previous</button>
      <span id="control-hint">Choose a wheel design to continue.</span>
      <button class="carbon-button carbon-button--primary" id="next-step" type="button" disabled>Next step →</button>
    </footer>
  </section>
</Base>

<style>
.studio-shell{background:#0b0c0e;color:#f4f4f4;padding:clamp(28px,5vw,76px) var(--page-gutter) 70px;min-height:80vh}.studio-shell *{box-sizing:border-box}.studio-shell input,.studio-shell select,.studio-shell textarea,.studio-shell button{font:inherit}.studio-heading,.studio-content,.studio-progress,.studio-controls{max-width:1440px;margin-inline:auto}.studio-heading{display:flex;justify-content:space-between;gap:32px;align-items:end;padding-bottom:42px}.studio-eyebrow,.step-kicker{font-size:11px;letter-spacing:.16em;font-weight:700;color:#8d96a0}.studio-heading h1{font-size:clamp(42px,6vw,82px);line-height:.94;letter-spacing:-.055em;margin:20px 0}.studio-heading h1 span,.studio-step h2 span{color:#9bbcff}.studio-intro{color:#a7adb4;max-width:560px;line-height:1.7}.reference-panel{background:#17191c;padding:20px 24px;min-width:250px;border-left:3px solid #0f62fe;display:grid;gap:8px}.reference-panel span,.reference-panel small{font-size:10px;letter-spacing:.12em;color:#969da5}.reference-panel strong{font-size:18px;letter-spacing:.04em}.studio-progress{position:sticky;top:0;z-index:10;background:#0b0c0e;padding:18px 0 16px;border-bottom:1px solid #282c31}.progress-track{height:4px;background:#34383d;position:relative}.progress-track span{display:block;width:14.28%;height:4px;background:#0f62fe;transition:width .35s ease}.studio-progress ol{display:grid;grid-template-columns:repeat(7,1fr);gap:8px;list-style:none;padding:0;margin:14px 0 10px}.studio-progress li{display:flex;gap:8px;align-items:center;color:#717981;font-size:11px;min-width:0}.studio-progress li span{font-variant-numeric:tabular-nums}.studio-progress li b{font-weight:500;white-space:nowrap}.studio-progress li.is-current,.studio-progress li.is-complete{color:#f4f4f4}.studio-progress li.is-current span{color:#78a9ff}.progress-caption{display:flex;gap:14px;font-size:10px;letter-spacing:.12em;color:#a7adb4}.progress-caption span:first-child{color:#78a9ff}.studio-content{padding:48px 0 34px;min-height:550px}.