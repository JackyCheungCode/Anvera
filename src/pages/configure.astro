center;font-size:26px;margin-bottom:25px}.completion-copy{max-width:620px;color:#a7adb4;line-height:1.7}.completion-reference{display:grid;gap:8px;padding:20px;background:#17191c;max-width:360px;margin:25px 0}.completion-reference small,.completion-reference span{font-size:10px;color:#9da5ad;letter-spacing:.1em}.completion-reference strong{font-size:22px}@keyframes wheelReveal{from{transform:scale(.82) rotate(-20deg);opacity:.3}to{transform:scale(1) rotate(0);opacity:1}}@keyframes nodeProgress{from{transform:scaleX(.12)}to{transform:scaleX(1)}}@keyframes truckMove{from{transform:translateX(-100px)}to{transform:translateX(100px)}}@media(max-width:1000px){.design-grid{grid-template-columns:repeat(2,1fr)}.manufacturing-track{grid-template-columns:repeat(4,1fr)}.studio-progress li b{display:none}.studio-progress li{justify-content:center}.vehicle-filter-row,.delivery-form-grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:620px){.studio-heading{display:block}.reference-panel{margin-top:24px}.studio-progress ol{gap:2px}.studio-progress li{font-size:9px}.studio-progress li span{font-size:9px}.studio-content{padding-top:30px}.design-grid,.spec-path-grid,.vehicle-filter-row,.delivery-form-grid,.spec-columns{grid-template-columns:1fr}.design-art{height:180px}.vehicle-preview{grid-template-columns:1fr}.vehicle-preview-art{min-height:130px}.custom-spec-fields{grid-template-columns:1fr}.custom-spec-fields .upload-field,.custom-response{grid-column:auto}.manufacturing-track{grid-template-columns:repeat(2,1fr)}.manufacturing-summary{padding:20px}.manufacturing-summary strong{font-size:32px}.manufacturing-wheel .wheel-render{width:80px;height:80px}.route-stages{grid-template-columns:repeat(2,1fr)}.route-heading{align-items:start;flex-direction:column}.document-section{grid-template-columns:1fr;gap:8px}.document-header{flex-direction:column}.document-reference{text-align:left;grid-template-columns:1fr 1fr}.document-footer{align-items:start;flex-direction:column;gap:10px}.confirmation-actions{flex-direction:column}.studio-controls{flex-wrap:wrap}.studio-controls>span{order:3;flex-basis:100%}.studio-controls .carbon-button{flex:1}.delivery-address{grid-column:auto}}
