---
import Base from "../layouts/Base.astro";
import { getEmDashCollection } from "emdash";
import { Image } from "emdash/ui";
import { wheelDevelopmentProducts } from "../data/wheel-products";
import VehicleFitmentFinder from "../components/VehicleFitmentFinder.astro";
import TextInput from "../components/ui/TextInput.astro";
import TextArea from "../components/ui/TextArea.astro";
import FileUploader from "../components/ui/FileUploader.astro";
import Button from "../components/ui/Button.astro";

const turnstileSiteKey = "0x4AAAAAAF-OqItFi-JleERp";

const { entries: wheelEntries = [] } = await getEmDashCollection("wheel_products", { status: "published", limit: 100, orderBy: { display_order: "asc" } }).catch(() => ({ entries: [] }));
const products = wheelEntries.length ? wheelEntries.map((entry: any) => ({
  slug: entry.id,
  title: String(entry.data?.title ?? "ANVERA forged wheel"),
  code: String(entry.data?.model_code ?? ""),
  construction: String(entry.data?.construction_type ?? "monoblock").replaceAll("_", "-"),
  constructionType: String(entry.data?.construction_type ?? "monoblock").replaceAll("_", "-"),
  designStyle: String(entry.data?.design_style ?? entry.data?.style ?? "Performance"),
  diameterOptions: Array.isArray(entry.data?.diameter_options) ? entry.data.diameter_options : [],
  widthOptions: Array.isArray(entry.data?.width_options) ? entry.data.width_options : [],
  pcdOptions: Array.isArray(entry.data?.pcd_options) ? entry.data.pcd_options : [],
  finishOptions: Array.isArray(entry.data?.finish_options) ? entry.data.finish_options : [],
  description: String(entry.data?.short_description ?? ""),
  diameter: Array.isArray(entry.data?.diameter_options) ? entry.data.diameter_options.join(" / ") : "Vehicle-specific sizing",
  image: entry.data?.hero_image ?? null,
})) : wheelDevelopmentProducts.map((product) => ({
  slug: product.slug, title: product.title, code: product.modelCode,
  construction: product.constructionType.replaceAll("_", "-"),
  constructionType: product.constructionType.replaceAll("_", "-"),
  designStyle: product.designStyle, diameterOptions: product.diameterOptions,
  widthOptions: product.widthOptions, pcdOptions: product.pcdOptions, finishOptions: product.finishOptions,
  description: product.shortDescription, diameter: product.diameterOptions.join(" / "), image: null,
}));
---
<Base title="Configure Your ANVERA Wheels" description="Configure ANVERA forged wheels around your vehicle, engineering requirements and delivery destination.">
  <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
  <section class="studio-shell" id="configuration-studio" data-product-rows={JSON.stringify(products.map(({ image, ...product }) => product))}>
    <header class="studio-heading">
      <div>
        <p class="studio-eyebrow">ANVERA / CUSTOMER CONFIGURATION STUDIO</p>
        <h1>Configure your<br /><span>forged wheels.</span></h1>
        <p class="studio-intro">A considered process from wheel design to delivery. Your configuration reference is created as soon as you begin.</p>
      </div>
      <aside class="reference-panel">
        <span>CONFIGURATION REFERENCE</span>
        <strong id="reference-code">Creating reference…</strong>
        <small id="reference-state">Creating secure server draft…</small>
      </aside>
    </header>

    <nav class="studio-progress" aria-label="Configuration progress">
      <div class="progress-track"><span id="progress-fill"></span></div>
      <ol id="progress-steps">
        <li class="is-current" data-step-label="1"><span>01</span><b>Design</b></li>
        <li data-step-label="2"><span>02</span><b>Vehicle & fitment</b></li>
        <li data-step-label="3"><span>03</span><b>Manufacturing</b></li>
        <li data-step-label="4"><span>04</span><b>Delivery</b></li>
        <li data-step-label="5"><span>05</span><b>Confirmation</b></li>
        <li data-step-label="6"><span>06</span><b>Complete</b></li>
      </ol>
      <div class="progress-caption"><span id="progress-current">STEP 01 / 06</span><span id="progress-title">Select a wheel design</span></div>
    </nav>

    <main class="studio-content">
      <section class="studio-step is-active" data-step="1">
        <div class="step-heading"><div><p class="step-kicker">01 / DESIGN SELECTION</p><h2>Choose your wheel design.</h2><p>Start with a design direction. Every selection can be refined later.</p></div><span class="step-index">01—06</span></div>
        <div class="design-filter-bar" aria-label="Filter wheel designs">
<div class="design-filter-field"><div class="carbon-dropdown cds--g100" data-carbon-dropdown data-label="Construction"><input type="hidden" id="filter-construction" value="" /></div></div>
<div class="design-filter-field"><div class="carbon-dropdown cds--g100" data-carbon-dropdown data-label="Design style"><input type="hidden" id="filter-style" value="" /></div></div>
<div class="design-filter-field"><div class="carbon-dropdown cds--g100" data-carbon-dropdown data-label="Diameter"><input type="hidden" id="filter-diameter" value="" /></div></div>
<div class="design-filter-field"><div class="carbon-dropdown cds--g100" data-carbon-dropdown data-label="Width / J"><input type="hidden" id="filter-width" value="" /></div></div>
<div class="design-filter-field"><div class="carbon-dropdown cds--g100" data-carbon-dropdown data-label="PCD"><input type="hidden" id="filter-pcd" value="" /></div></div><span class="design-filter-count" id="design-filter-count">All designs</span></div>
<div class="design-grid" id="design-grid">
          {products.map((product, index) => (
            <Button className="design-card" productKey={product.slug} ariaPressed={false} variant="ghost" type="button">
              <span class="design-art">{product.image ? <Image image={product.image} width={900} height={675} /> : <span class:list={["wheel-render", `design-wheel-${index % 5}`]}></span>}<i>{String(index + 1).padStart(2, "0")}</i></span>
              <span class="design-meta"><b>{product.title}</b><small>{product.code} / {product.construction.toUpperCase()}</small><small>{product.diameter || "Vehicle-specific sizing"}</small></span>
              <span class="design-check" aria-hidden="true">✓</span>
            </Button>
          ))}
        </div>
      </section>

      <section class="studio-step" data-step="2" hidden>
        <div class="step-heading"><div><p class="step-kicker">02 / VEHICLE SELECTION</p><h2>Find your vehicle fitment.</h2><p>Select your market and exact vehicle configuration, retrieve fitment references, then confirm or customize your wheel dimensions here.</p></div><span class="step-index">02—06</span></div>
        <div class="vehicle-selection-shell"><VehicleFitmentFinder compact={true} /></div>

        <p class="studio-note" id="vehicle-status" role="status">Choose your market and vehicle, then select Find fitment to load OEM and alternative references below.</p>

        <div class="spec-detail" id="spec-detail">
          <div class="spec-detail-heading"><div><p class="step-kicker" id="spec-detail-kicker">SELECTED VEHICLE FITMENT</p><h3 id="spec-detail-title">Selected fitment specification</h3></div><span class="review-status">ENGINEERING REVIEW REQUIRED</span></div>
          <p class="fitment-status" id="fitment-status" role="status">Select a fitment result above. Its front and rear dimensions will appear here.</p>
          <div class="spec-table-wrap" id="spec-reference"><table class="spec-table"><thead><tr><th>Parameter</th><th>Front</th><th>Rear</th></tr></thead><tbody><tr><th>Diameter</th><td id="front-diameter">—</td><td id="rear-diameter">—</td></tr><tr><th>Width / J</th><td id="front-width">—</td><td id="rear-width">—</td></tr><tr><th>PCD</th><td id="front-pcd">Vehicle-specific</td><td id="rear-pcd">Vehicle-specific</td></tr><tr><th>Offset / ET</th><td id="front-offset">—</td><td id="rear-offset">—</td></tr><tr><th>Centre bore</th><td id="front-bore">—</td><td id="rear-bore">—</td></tr></tbody></table><p class="locked-fitment-note">PCD and centre bore are vehicle-dependent safety dimensions. They cannot be changed in a standard fitment selection. Request engineering review for any change.</p></div>
          <div class="finish-selection" id="finish-selection"><div class="finish-field"><div class="carbon-dropdown cds--g100" data-carbon-dropdown data-label="Surface treatment"><input type="hidden" id="wheel-finish" value="brushed" /></div></div><div class="finish-field"><div class="carbon-dropdown cds--g100" data-carbon-dropdown data-label="Colour"><input type="hidden" id="wheel-colour" value="satin-black" /></div></div></div>
          <section class="custom-spec-entry" aria-labelledby="custom-spec-heading">
            <div><p class="step-kicker">OPTIONAL / BESPOKE SETUP</p><h3 id="custom-spec-heading">Custom Specification</h3><p>Keep the selected fitment as your baseline, or enter different front and rear dimensions for engineering review.</p></div>
            <Button id="custom-spec-toggle" className="carbon-button carbon-button--secondary" variant="secondary" ariaExpanded={false} type="button">Customize dimensions <span aria-hidden="true">＋</span></Button>
          </section>
          <div class="custom-spec-fields" id="custom-spec-fields" hidden><input type="hidden" id="custom-front" /><input type="hidden" id="custom-rear" />
            <div class="custom-wheel-side"><h4>FRONT WHEEL</h4>
              <TextInput id="custom-front-diameter" name="frontDiameter" label="Diameter" placeholder="20 in" className="cds--g100" />
              <TextInput id="custom-front-width" name="frontWidth" label="Width / J" placeholder="9.0J" className="cds--g100" />
              <TextInput id="custom-front-pcd" name="frontPcd" label="PCD" placeholder="Vehicle-specific PCD" readOnly className="cds--g100" />
              <TextInput id="custom-front-offset" name="frontOffset" label="Offset / ET" placeholder="ET25" className="cds--g100" />
              <TextInput id="custom-front-bore" name="frontBore" label="Centre bore" placeholder="Vehicle-specific" readOnly className="cds--g100" />
            </div>
            <div class="custom-wheel-side"><h4>REAR WHEEL</h4>
              <TextInput id="custom-rear-diameter" name="rearDiameter" label="Diameter" placeholder="20 in" className="cds--g100" />
              <TextInput id="custom-rear-width" name="rearWidth" label="Width / J" placeholder="10.5J" className="cds--g100" />
              <TextInput id="custom-rear-pcd" name="rearPcd" label="PCD" placeholder="Vehicle-specific PCD" readOnly className="cds--g100" />
              <TextInput id="custom-rear-offset" name="rearOffset" label="Offset / ET" placeholder="ET35" className="cds--g100" />
              <TextInput id="custom-rear-bore" name="rearBore" label="Centre bore" placeholder="Vehicle-specific" readOnly className="cds--g100" />
            </div>
            <div class="pcd-change-request"><p>PCD and centre bore are determined by the selected vehicle. To request a change, use the engineering override below. Changes may affect hub compatibility, fastener seating and vehicle safety.</p><Button id="request-pcd-change" className="carbon-button carbon-button--ghost" variant="ghost" type="button">Request PCD / bore change</Button></div>
            <TextArea id="custom-notes" name="customNotes" label="Additional engineering notes" rows={3} placeholder="Brake package, suspension, tyre size or other requirements…" /><div class="upload-field"><FileUploader id="custom-files" name="customFiles" label="Vehicle / wheel reference photos" accept={["image/*", ".pdf"]} multiple description="Add reference images or PDF drawings for engineering review." /></div><p class="custom-response">Our engineering team will review your custom specifications and respond within <strong>1 business day</strong> after submission.</p></div>
        </div>
      </section>

      <section class="studio-step" data-step="3" hidden>
        <div class="step-heading"><div><p class="step-kicker">03 / MANUFACTURING</p><h2>From forged billet to finished wheel.</h2><p>An initial manufacturing estimate based on a typical bespoke forged wheel project.</p></div><span class="step-index">03—06</span></div>
        <div class="manufacturing-summary"><div><span>ESTIMATED MANUFACTURING TIME</span><strong>15–27 <small>working days</small></strong><p>Planning estimate only. Final lead time is confirmed after engineering review and order acceptance.</p></div><div class="manufacturing-wheel"><span class="wheel-render"></span></div></div>
        <div class="manufacturing-track" id="manufacturing-track">
          <article class="manufacturing-node"><span class="manufacturing-icon" aria-hidden="true">▣</span><div><b>Engineering confirmation</b><p>Review vehicle, dimensions and brake clearance</p></div><strong>1–3 days</strong></article>
          <article class="manufacturing-node"><span class="manufacturing-icon" aria-hidden="true">▤</span><div><b>Material preparation</b><p>Forging billet preparation and material traceability</p></div><strong>2–4 days</strong></article>
          <article class="manufacturing-node"><span class="manufacturing-icon" aria-hidden="true">⚒</span><div><b>Aluminium forging</b><p>Controlled forging and blank preparation</p></div><strong>2–3 days</strong></article>
          <article class="manufacturing-node"><span class="manufacturing-icon" aria-hidden="true">⚙</span><div><b>CNC precision machining</b><p>Spoke, barrel, hub and mounting geometry</p></div><strong>4–7 days</strong></article>
          <article class="manufacturing-node"><span class="manufacturing-icon" aria-hidden="true">✦</span><div><b>Surface finishing</b><p>Preparation, coating and final finish</p></div><strong>3–5 days</strong></article>
          <article class="manufacturing-node"><span class="manufacturing-icon" aria-hidden="true">✓</span><div><b>Assembly & quality inspection</b><p>Dimensional, runout and appearance checks</p></div><strong>2–3 days</strong></article>
          <article class="manufacturing-node"><span class="manufacturing-icon" aria-hidden="true">▣</span><div><b>Packaging & dispatch readiness</b><p>Protective packing and export preparation</p></div><strong>1–2 days</strong></article>
        </div>
        <p class="studio-note">The animated sequence illustrates the planned production stages; it does not represent live factory progress. Some operations may overlap depending on the final construction and factory schedule.</p>
      </section>
      <section class="studio-step" data-step="4" hidden>
        <div class="step-heading"><div><p class="step-kicker">04 / DELIVERY & LOGISTICS</p><h2>Where should we deliver?</h2><p>Choose the Incoterm and destination. The route and arrival window will be estimated from the destination address.</p></div><span class="step-index">04—06</span></div>
        <div class="delivery-form-grid">
          <div class="delivery-field"><div class="carbon-dropdown cds--g100" data-carbon-dropdown data-label="Delivery term"><input type="hidden" id="delivery-term" value="FOB" /></div></div>
          <div class="delivery-field"><div class="carbon-dropdown cds--g100" data-carbon-dropdown data-label="Transport method"><input type="hidden" id="shipping-method" value="sea" /></div></div>
          <div class="delivery-field"><div class="carbon-dropdown cds--g100" data-carbon-dropdown data-label="Country / territory"><input type="hidden" id="delivery-country" value="" /></div></div>
          <div class="delivery-field">
            <div class="carbon-dropdown cds--g100" data-carbon-dropdown data-label="State / province"><input type="hidden" id="delivery-region" value="" /></div>
            <div id="delivery-region-other-wrap" hidden><TextInput id="delivery-region-other" name="deliveryRegionOther" label="Enter state / province" placeholder="State / province" className="cds--g100" /></div>
          </div>
          <div class="delivery-field">
            <div class="carbon-dropdown cds--g100" data-carbon-dropdown data-label="City"><input type="hidden" id="delivery-city" value="" /></div>
            <div id="delivery-city-other-wrap" hidden><TextInput id="delivery-city-other" name="deliveryCityOther" label="Enter city" placeholder="City" className="cds--g100" /></div>
          </div>
          <TextInput id="delivery-postal" name="postalCode" label="Postal code" autocomplete="postal-code" placeholder="Postal code" className="cds--g100" />
          <div class="delivery-address"><TextInput id="delivery-address" name="address" label="Street address" autocomplete="street-address" placeholder="Street, building and unit number" className="cds--g100" /></div>
          <TextInput id="contact-name" name="contactName" label="Contact name" autocomplete="name" placeholder="Full name" className="cds--g100" />
          <TextInput id="contact-email" name="email" label="Email" type="email" autocomplete="email" placeholder="name@example.com" className="cds--g100" />
          <TextInput id="contact-phone" name="phone" label="Phone / WhatsApp" type="tel" autocomplete="tel" placeholder="Country code + number" className="cds--g100" />
        </div>
        <div class="route-estimate">
          <div class="route-heading"><div><p class="step-kicker">LOGISTICS ROUTE / PLANNING VIEW</p><h3>Chengdu → Yantian → Destination</h3></div><span class="route-tag">SEA FREIGHT DEFAULT</span></div>
          <div class="route-stages">
            <div class="route-stage"><span class="route-dot">01</span><b>Chengdu factory</b><small>Factory dispatch</small><em>1–2 days</em></div>
            <div class="route-stage"><span class="route-dot">02</span><b>Shenzhen Yantian Port</b><small>Road freight · export handling</small><em>2–4 days</em></div>
            <div class="route-stage"><span class="route-dot">03</span><b>Destination port</b><small>Ocean transit · customs</small><em id="ocean-estimate">Route required</em></div>
            <div class="route-stage"><span class="route-dot">04</span><b>Delivery address</b><small>Local transport</small><em>Route required</em></div>
          </div>
          <div class="route-map-placeholder"><div class="route-journey"><span class="map-pin" data-lat="30.5728" data-lng="104.0668">CHENGDU<br/>CITY REFERENCE</span><span class="map-leg map-leg--road"><b class="map-truck">🚚</b></span><span class="map-pin" data-lat="22.5618" data-lng="114.2668">YANTIAN PORT</span><span class="map-leg map-leg--sea"><b class="map-ship">🚢</b></span><span class="map-pin">DESTINATION PORT</span><span class="map-leg map-leg--local"><b class="map-truck map-truck--last">🚚</b></span><span class="map-pin">DELIVERY ADDRESS</span></div><p>Chengdu city-center proxy: 30.5728°N, 104.0668°E (not the verified factory gate). Yantian Port reference: 22.5618°N, 114.2668°E. Route animation is illustrative, not a navigable road or sea route.</p></div>
          <div class="arrival-estimate"><span>ESTIMATED TOTAL DELIVERY WINDOW</span><strong id="delivery-window">Awaiting destination details</strong><small id="delivery-window-note">Includes manufacturing estimate and indicative transport stages; customs and carrier schedules may change the arrival date.</small></div>
        </div>
        <p class="studio-note">Incoterms allocate delivery obligations, costs and risk. FOB is intended for sea or inland-waterway transport; the selected term will be explained in the confirmation document.</p>
      </section>

      <section class="studio-step" data-step="5" hidden>
        <div class="step-heading"><div><p class="step-kicker">05 / CONFIGURATION CONFIRMATION</p><h2>Review your configuration.</h2><p>Your confirmation document records the brief and planning estimates. It contains no price and is not a sales contract.</p></div><span class="step-index">05—06</span></div>
        <article class="confirmation-document" id="confirmation-document">
          <header class="document-header"><div><span>ANVERA / FORGED WHEEL ENGINEERING</span><h2>Configuration<br />Confirmation</h2></div><div class="document-reference"><small>REFERENCE</small><b id="document-reference">—</b><small>CREATED</small><b id="document-date">—</b></div></header>
          <div class="document-rule"></div>
          <section class="document-section"><span>01 / SELECTED DESIGN</span><div class="document-value"><b id="document-design">—</b><small id="document-construction">—</small></div></section>
          <section class="document-section"><span>02 / VEHICLE</span><div class="document-value"><b id="document-vehicle">—</b><small id="document-vehicle-detail">—</small></div></section>
          <section class="document-section"><span>03 / WHEEL SPECIFICATION</span><div class="document-value"><b id="document-spec-type">—</b><small id="document-spec-details">—</small><small class="document-warning">Fitment subject to ANVERA engineering verification.</small></div></section>
          <section class="document-section"><span>03 / MANUFACTURING PLAN</span><div class="document-value"><b>Estimated 15–27 working days</b><small>Seven planned production stages. Not live production tracking.</small></div></section>
          <section class="document-section"><span>04 / DELIVERY</span><div class="document-value"><b id="document-delivery">—</b><small id="document-address">—</small><small id="document-arrival">—</small></div></section>
          <section class="document-section"><span>05 / CUSTOMER CONTACT</span><div class="document-value"><b id="document-contact">—</b><small id="document-email">—</small><small id="document-phone">—</small></div></section>
          <footer class="document-footer"><b>ANVERA</b><span>CONFIGURATION RECORD · NO PRICING · SUBJECT TO REVIEW</span></footer>
        </article>
        {<div class="cf-turnstile" data-sitekey={turnstileSiteKey}></div>}
        <div class="confirmation-actions"><Button id="download-pdf" className="carbon-button carbon-button--secondary" variant="secondary" type="button">Export PDF ↓</Button><Button id="submit-configuration" className="carbon-button carbon-button--primary" type="button">Submit configuration ↗</Button></div>
        <p class="studio-note" id="submit-status" role="status">Submitting creates a review request. ANVERA will confirm fitment, quotation and final delivery schedule separately.</p>
      </section>

      <section class="studio-step" data-step="6" hidden>
        <div class="completion-mark">✓</div>
        <p class="step-kicker">06 / CONFIGURATION PREPARED</p>
        <h2>Thank you for<br /><span>choosing ANVERA.</span></h2>
        <p class="completion-copy" id="completion-status">Your configuration has been prepared.</p>
        <div class="completion-reference"><small>YOUR REFERENCE</small><strong id="completion-reference">—</strong><span>Keep this reference for future correspondence.</span></div>
        <a class="carbon-button carbon-button--primary" id="track-configuration-link" href="/configuration/track">Track this configuration ↗</a>
        <a class="carbon-button carbon-button--secondary" href="/dealers">Explore ANVERA</a>
      </section>
    </main>

    <footer class="studio-controls" id="studio-controls">
      <Button id="previous-step" className="carbon-button carbon-button--ghost" variant="ghost" type="button" disabled>← Previous</Button>
      <span id="control-hint">Choose a wheel design to continue.</span>
      <Button id="next-step" className="carbon-button carbon-button--primary" type="button" disabled>Next step →</Button>
    </footer>
  </section>
</Base>

<style>
.studio-shell{background:#0b0c0e;color:#f4f4f4;padding:clamp(28px,5vw,76px) var(--page-gutter) 70px;min-height:80vh}.studio-shell *{box-sizing:border-box}.studio-shell input,.studio-shell select,.studio-shell textarea,.studio-shell button{font:inherit}.studio-heading,.studio-content,.studio-progress,.studio-controls{max-width:1440px;margin-inline:auto}.studio-heading{display:flex;justify-content:space-between;gap:32px;align-items:end;padding-bottom:42px}.studio-eyebrow,.step-kicker{font-size:11px;letter-spacing:.16em;font-weight:700;color:#8d96a0}.studio-heading h1{font-size:clamp(42px,6vw,82px);line-height:.94;letter-spacing:-.055em;margin:20px 0}.studio-heading h1 span,.studio-step h2 span{color:#9bbcff}.studio-intro{color:#a7adb4;max-width:560px;line-height:1.7}.reference-panel{background:#17191c;padding:20px 24px;min-width:250px;border-left:3px solid #0f62fe;display:grid;gap:8px}.reference-panel span,.reference-panel small{font-size:10px;letter-spacing:.12em;color:#969da5}.reference-panel strong{font-size:18px;letter-spacing:.04em}.studio-progress{position:sticky;top:0;z-index:10;background:#0b0c0e;padding:18px 0 16px;border-bottom:1px solid #282c31}.progress-track{height:4px;background:#34383d;position:relative}.progress-track span{display:block;width:16.6667%;height:4px;background:#0f62fe;transition:width .35s ease}.studio-progress ol{display:grid;grid-template-columns:repeat(7,1fr);gap:8px;list-style:none;padding:0;margin:14px 0 10px}.studio-progress li{display:flex;gap:8px;align-items:center;color:#717981;font-size:11px;min-width:0}.studio-progress li span{font-variant-numeric:tabular-nums}.studio-progress li b{font-weight:500;white-space:nowrap}.studio-progress li.is-current,.studio-progress li.is-complete{color:#f4f4f4}.studio-progress li.is-current span{color:#78a9ff}.progress-caption{display:flex;gap:14px;font-size:10px;letter-spacing:.12em;color:#a7adb4}.progress-caption span:first-child{color:#78a9ff}.studio-content{padding:48px 0 34px;min-height:550px