  const uniqueRows=values=>[...new Set((values||[]).filter(value=>value!==null&&value!==undefined&&String(value).trim()!=="").map(String))].sort((a,b)=>a.localeCompare(b)).map(value=>({value,label:value}));
  const setupOptions=(control,rows,placeholder)=>{renderDropdownOptions(control,rows,placeholder);setDropdownLabel(control,placeholder);control.trigger.disabled=false;};
  setupOptions(constructionFilter,uniqueRows(productRows.map(row=>row.constructionType||row.construction)),"All constructions");
  setupOptions(styleFilter,uniqueRows(productRows.map(row=>row.designStyle||row.style)),"All styles");
  setupOptions(diameterFilter,uniqueRows(productRows.flatMap(row=>Array.isArray(row.diameterOptions)?row.diameterOptions:[])),"All diameters");
  setupOptions(widthFilter,uniqueRows(productRows.flatMap(row=>Array.isArray(row.widthOptions)?row.widthOptions:[])),"All widths");
  setupOptions(pcdFilter,uniqueRows(productRows.flatMap(row=>Array.isArray(row.pcdOptions)?row.pcdOptions:[])),"All PCD");
  setupOptions(finishControl,["brushed","polished","machined","painted","powder-coated","anodized"].map(value=>({value,label:value.replaceAll("-"," ").replace(/\\b\\w/g,c=>c.toUpperCase())})),"Select surface treatment");
  setupOptions(colourControl,["satin-black","gloss-black","titanium","graphite","silver","bronze","custom"].map(value=>({value,label:value.replaceAll("-"," ").replace(/\\b\\w/g,c=>c.toUpperCase())})),"Select colour");
  setupOptions(deliveryTermControl,[
    ["FOB","FOB — Free On Board"],["EXW","EXW — Ex Works"],["FAS","FAS — Free Alongside Ship"],["FCA","FCA — Free Carrier"],["CFR","CFR — Cost and Freight"],["CIF","CIF — Cost, Insurance and Freight"],["CPT","CPT — Carriage Paid To"],["CIP","CIP — Carriage and Insurance Paid To"],["DAP","DAP — Delivered at Place"],["DPU","DPU — Delivered at Place Unloaded"],["DDP","DDP — Delivered Duty Paid"]
  ].map(([value,label])=>({value,label})),"Select delivery term");
  setupOptions(transportControl,[{value:"sea",label:"Sea freight (default)"},{value:"air",label:"Air freight (estimate required)"}],"Select transport method");
  const selectDropdownOption=async(control,option)=>{
    const value=option.value;
    const label=option.label;
    if(!value)return;
    setDropdownValue(control,value,label);
    closeDropdowns();
    if(control===countryControl){
      ++regionRequestId;++cityRequestId;
      setDropdownValue(regionControl,"","Loading states / provinces…");
      setDropdownValue(cityControl,"","Select state / province first");
      regionControl.trigger.disabled=true;cityControl.trigger.disabled=true;
      root.querySelector("#delivery-region-other-wrap").hidden=true;root.querySelector("#delivery-city-other-wrap").hidden=true;
      await loadDeliveryRegions(value);
    }else if(control===regionControl){
      ++cityRequestId;
      root.querySelector("#delivery-region-other-wrap").hidden=value!=="__none__";
      setDropdownValue(cityControl,"","Loading cities…");
      cityControl.trigger.disabled=true;root.querySelector("#delivery-city-other-wrap").hidden=true;
      await loadDeliveryCities(countryControl.input.value,value==="__none__"?"":label);
    }else if(control===cityControl){
      root.querySelector("#delivery-city-other-wrap").hidden=value!=="__other__";
    }
  };
  const setDropdownValue=(control,value,label)=>{
    if(!control)return;
    control.input.value=value;
    if(label)control.placeholder=label;
    renderControl(control);
    control.input.dispatchEvent(new Event("change",{bubbles:true}));
    control.input.dispatchEvent(new Event("input",{bubbles:true}));
  };
  const closeDropdowns=except=>{
    root.querySelectorAll("[data-carbon-dropdown].is-open").forEach(dropdown=>{
      if(dropdown===except)return;
      dropdown.classList.remove("is-open");
      dropdown.querySelector(".carbon-dropdown-menu")?.setAttribute("hidden","");
      dropdown.querySelector(".carbon-dropdown-trigger")?.setAttribute("aria-expanded","false");
    });
  };
  let regionRequestId=0,cityRequestId=0;
  root.addEventListener("input",event=>{
    const target=event.target instanceof HTMLInputElement?event.target:null;
    if(!target?.classList.contains("carbon-dropdown-search"))return;
    const query=target.value.trim().toLocaleLowerCase();
    const menu=target.closest(".carbon-dropdown-menu");
    menu?.querySelectorAll("[data-dropdown-option]").forEach(option=>{
      option.hidden=!option.textContent.toLocaleLowerCase().includes(query);
    });
  });
  root.addEventListener("click",async event=>{
    const target=event.target instanceof Element?event.target:null;
    const trigger=target?.closest(".carbon-dropdown-trigger");
    if(trigger&&root.contains(trigger)){
      const dropdown=trigger.closest("[data-carbon-dropdown]");
      if(trigger.disabled)return;
      const opening=!dropdown.classList.contains("is-open");
      closeDropdowns(dropdown);
      dropdown.classList.toggle("is-open",opening);
      const menu=dropdown.querySelector(".carbon-dropdown-menu");
      if(menu)menu.hidden=!opening;
      trigger.setAttribute("aria-expanded",String(opening));
      if(opening)menu?.querySelector(".carbon-dropdown-search")?.focus();
      event.preventDefault();return;
    }
  }, true);
  document.addEventListener("click",event=>{
    const target=event.target instanceof Node?event.target:null;
    if(target&&!root.contains(target))closeDropdowns();
  });
  const loadDeliveryRegions=async countryCode=>{
    const requestId=++regionRequestId;
    const country=countryRows.find(row=>row.value===countryCode)?.label||countryCode;
    const regionRows=[];
    try{
      const response=await fetch("/api/delivery-locations",{method:"POST",headers:{"Content-Type":"application/json",Accept:"application/json"},body:JSON.stringify({type:"states",countryCode,country})});
      if(!response.ok)throw new Error("states_http_"+response.status);
      const payload=await response.json();
      if(!payload?.ok)throw new Error(payload?.error||"states_lookup_failed");
      (Array.isArray(payload.regions)?payload.regions:[]).forEach(name=>{if(name)regionRows.push({value:String(name),label:String(name)});});
    }catch(error){console.warn("Delivery state/province lookup failed",error);}
    if(requestId!==regionRequestId)return;
    regionRows.push({value:"__none__",label:regionRows.length?"Other / enter manually":"State / province unavailable — enter manually"});
    renderDropdownOptions(regionControl,regionRows,"Search state / province…");
    setDropdownLabel(regionControl,regionRows.length>1?"Select state / province":"Enter state / province manually");
    regionControl.trigger.disabled=false;
    if(regionRows.length===1){regionControl.input.value="__none__";renderControl(regionControl);root.querySelector("#delivery-region-other-wrap").hidden=false;setDropdownValue(cityControl,"__other__","Enter city manually");root.querySelector("#delivery-city-other-wrap").hidden=false;cityControl.trigger.disabled=false;}
  };
  const loadDeliveryCities=async(countryCode,stateName)=>{
    const requestId=++cityRequestId;
    const country=countryRows.find(row=>row.value===countryCode)?.label||countryCode;
    let cityRows=[];
    if(stateName){
      try{
        const response=await fetch("/api/delivery-locations",{method:"POST",headers:{"Content-Type":"application/json",Accept:"application/json"},body:JSON.stringify({type:"cities",countryCode,country,state:stateName})});
        if(!response.ok)throw new Error("cities_http_"+response.status);
        const payload=await response.json();
        if(!payload?.ok)throw new Error(payload?.error||"city_lookup_failed");
        cityRows=(Array.isArray(payload.cities)?payload.cities:[]).filter(Boolean).map(name=>({value:String(name),label:String(name)}));
      }catch(error){console.warn("Delivery city lookup failed",error);}
    }
    if(requestId!==cityRequestId)return;
    cityRows.push({value:"__other__",label:cityRows.length?"Other / enter city manually":"City list unavailable — enter manually"});
    renderDropdownOptions(cityControl,cityRows,"Search city…");
    setDropdownLabel(cityControl,"Select city");
    cityControl.trigger.disabled=false;
  };
  const loadDeliveryCountries=()=>{
    renderDropdownOptions(countryControl,countryRows.map(({value,label,flag})=>({value,label,flag})),"Search country or territory…");
    setDropdownLabel(countryControl,"Select country or territory");
    setDropdownLabel(regionControl,"Select country first");
    setDropdownLabel(cityControl,"Select state / province first");
    countryControl.trigger.disabled=false;
    regionControl.trigger.disabled=true;cityControl.trigger.disabled=true;
  };
  loadDeliveryCountries();
  const deliveryIds=["delivery-term","shipping-method","delivery-postal","delivery-address","contact-name","contact-email","contact-phone"];
  deliveryIds.forEach(id=>root.querySelector("#"+id).addEventListener("input",()=>{state.delivery[id]=root.querySelector("#"+id).value;updateArrivalEstimate();updateProgress();}));
  ["delivery-country","delivery-region","delivery-city","delivery-term","shipping-method"].forEach(id=>root.querySelector("#"+id).addEventListener("change",()=>{state.delivery[id]=root.querySelector("#"+id).value;updateArrivalEstimate();updateProgress();}));
  root.querySelector("#request-pcd-change").addEventListener("click",()=>{const accepted=window.confirm("PCD / centre bore are safety-critical and normally fixed by the vehicle hub. Changing them requires ANVERA engineering approval and may make the wheel incompatible. Continue with a request?");if(!accepted)return;["front","rear"].forEach(side=>["pcd","bore"].forEach(key=>{const field=root.querySelector("#custom-"+side+"-"+key);field.readOnly=false;field.placeholder="Requested change — engineering approval required";}));root.querySelector("#custom-notes").value=(root.querySelector("#custom-notes").value+"\nPCD / centre bore override requested. Validate hub and fastener compatibility.").trim();hint.textContent="PCD / bore override requested. ANVERA engineering approval is mandatory.";});
  const updateArrivalEstimate=()=>{const country=countryRows.find(c=>c.value===root.querySelector("#delivery-country").value)?.label||"",city=root.querySelector("#delivery-city").value==="__other__"?root.querySelector("#delivery-city-other").value.trim():root.querySelector("#delivery-city").value.trim();const complete=country&&city;root.querySelector("#delivery-window").textContent=complete?"Manufacturing + route estimate pending":"Awaiting destination details";root.querySelector("#delivery-window-note").textContent=complete?"Destination captured. A verified carrier and port route is required before calculating a reliable arrival date.":"Enter destination country and city to begin the delivery estimate.";root.querySelector("#ocean-estimate").textContent=complete?"Carrier schedule required":"Route required";};
  const buildConfirmation=()=>{const v=state.vehicle;const vehicle=[v.makeLabel||v.make,v.modelLabel||v.model,v.year,v.generation,v.trim].filter(Boolean).join(" ");const spec=state.specPath==="oem"?"OEM reference":state.specPath==="upgrade"?"ANVERA upgrade reference":"Custom specification";const address=[root.querySelector("#delivery-address").value.trim(),cityControl.input.value==="__other__"?root.querySelector("#delivery-city-other").value:cityControl.input.value,regionControl.input.value==="__none__"?root.querySelector("#delivery-region-other").value:regionControl.input.value,[countryRows.find(c=>c.value===countryControl.input.value)?.flag,countryRows.find(c=>c.value===countryControl.input.value)?.label].filter(Boolean).join(" "),root.querySelector("#delivery-postal").value.trim()].filter(Boolean).join(", ");const val=id=>root.querySelector("#"+id).value.trim()||"Not supplied";root.querySelector("#document-reference").textContent=state.reference;root.querySelector("#document-date").textContent=new Date().toLocaleDateString(undefined,{year:"numeric",month:"short",day:"numeric"});root.querySelector("#document-design").textContent=state.product?.title||"—";root.querySelector("#document-construction").textContent=state.product?.construction||"—";root.querySelector("#document-vehicle").textContent=vehicle||"—";root.querySelector("#document-vehicle-detail").textContent="Market: "+v.region;root.querySelector("#document-spec-type").textContent=spec;root.querySelector("#document-spec-details").textContent=state.specPath==="custom"?"Front: "+val("custom-front")+" / Rear: "+val("custom-rear"):"Reference values to be confirmed against verified vehicle fitment data.";root.querySelector("#document-spec-details").textContent+=" · Finish: "+val("wheel-finish")+" / Colour: "+val("wheel-colour");root.querySelector("#document-delivery").textContent=val("delivery-term")+" / "+(val("shipping-method")==="sea"?"Sea freight":"Air freight");root.querySelector("#document-address").textContent=address;root.querySelector("#document-arrival").textContent="Estimated delivery date pending verified route calculation.";root.querySelector("#document-contact").textContent=val("contact-name");root.querySelector("#document-email").textContent=val("contact-email");root.querySelector("#document-phone").textContent=val("contact-phone");};
  root.querySelector("#download-pdf").addEventListener("click",()=>window.print());
  root.querySelector("#submit-configuration").addEventListener("click",async()=>{
    const button=root.querySelector("#submit-configuration"),status=root.querySelector("#submit-status");
    if(!state.serverReady||!state.accessToken){status.textContent="The secure order service is not available yet. Your local draft remains saved on this device.";return;}
    const customerName=root.querySelector("#contact-name").value.trim(),email=root.querySelector("#contact-email").value.trim(),phone=root.querySelector("#contact-phone").value.trim();
