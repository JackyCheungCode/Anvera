      root.querySelector("#track-configuration-link").href="/configuration/track?reference="+encodeURIComponent(state.reference);
      root.querySelector("#completion-status").textContent=payload.status==="custom_review"?"Your custom specification has been submitted for engineering review. ANVERA will respond within 1 business day.":"Your configuration has been submitted. ANVERA will review fitment and confirm the quotation and delivery schedule.";
      status.textContent="Configuration submitted successfully.";
      saveDraft();setStep(6);
    }catch(error){const reason=error instanceof Error?error.message:"";status.textContent=reason==="verification_not_configured"?"Secure verification is not configured on the server yet. Please contact ANVERA.":"Submission could not be completed. Your draft is still saved; please try again.";// @ts-ignore Cloudflare Turnstile is injected by its external script.
      const turnstile=window.turnstile;if(turnstile?.reset)turnstile.reset();}
    finally{button.disabled=false;}
  });
  root.querySelector("#completion-reference").textContent=state.reference;
  root.querySelector("#track-configuration-link").href="/configuration/track?reference="+encodeURIComponent(state.reference);
  if(state.product){const selected=root.querySelector(`[data-product="${CSS.escape(state.product.slug)}"]`);selected?.setAttribute("aria-pressed","true");}
  updateProgress();
  createServerDraft();
</script>

