      const response=await fetch("/api/configuration-orders",{method:"POST",headers:{"Content-Type":"application/json","Authorization":"Bearer "+state.accessToken},body:JSON.stringify({action:"submit",referenceCode:state.reference,configuration:collectConfiguration(),customerName,email,phone,turnstileToken})});
      const payload=await response.json();
      if(!response.ok)throw new Error(payload.error||"submission_failed");
