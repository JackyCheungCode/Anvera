<script define:vars={{ productRows: products.map(({image, ...product}) => product) }}>
  const root = document.querySelector("#configuration-studio");
  const steps = [...root.querySelectorAll("[data-step]")];
  const labels = [...root.querySelectorAll("[data-step-label]")];
  const progressFill = root.querySelector("#progress-fill");
  const progressCurrent = root.querySelector("#progress-current");
  const progressTitle = root.querySelector("#progress-title");
  const previous = root.querySelector("#previous-step");
  const next = root.querySelector("#next-step");
  const hint = root.querySelector("#control-hint");
  const stepTitles = ["Select a wheel design","Select your vehicle","Choose specifications","Review manufacturing estimate","Set delivery destination","Review configuration document","Configuration received"];
  const draftKey = "anvera.configuration.draft.v1";
  const state = { step:1, reference:"", accessToken:"", serverReady:false, product:null, vehicle:{region:"sam",make:"",model:"",year:"",generation:"",trim:""}, specPath:"", customSubmitted:false, delivery:{term:"FOB",method:"sea"} };
  const makeReference = () => "LOCAL-" + new Date().getFullYear() + "-" + Math.random().toString(36).slice(2,8).toUpperCase();
  try {
    const saved = JSON.parse(localStorage.getItem(draftKey) || "null");
    if (saved && saved.reference && saved.step < 7) Object.assign(state, saved, {step:1});
  } catch {}
  if (!state.reference || !state.accessToken) { state.reference = makeReference(); state.accessToken = ""; state.serverReady = false; }
  root.querySelector("#reference-code").textContent = state.reference;
  root.querySelector("#reference-state").textContent = state.serverReady && state.accessToken ? "Server draft · saved securely" : "Creating secure server draft…";
  const saveDraft = () => { try { localStorage.setItem(draftKey, JSON.stringify({...state, updatedAt:new Date().toISOString()})); } catch {} };
  const collectConfiguration = () => ({
    step: state.step,
    product: state.product,
    vehicle: state.vehicle,
    specification: {
      path: state.specPath,
      selected: state.selectedFitment ? {
        front: state.selectedFitment.front,
        rear: state.selectedFitment.rear,
        classification: state.selectedFitment.classification
      } : null,
      customFront: root.querySelector("#custom-front")?.value || "",
      customRear: root.querySelector("#custom-rear")?.value || ""
    },
    specPath: state.specPath,
    customSubmitted: state.customSubmitted,
    delivery: {
      term: root.querySelector("#delivery-term")?.value || state.delivery.term,
      method: root.querySelector("#shipping-method")?.value || state.delivery.method,
      country: root.querySelector("#delivery-country")?.value || "",
      region: root.querySelector("#delivery-region")?.value || "",
      city: root.querySelector("#delivery-city")?.value || "",
      postal: root.querySelector("#delivery-postal")?.value || "",
      address: root.querySelector("#delivery-address")?.value || "",
      contactName: root.querySelector("#contact-name")?.value || "",
      email: root.querySelector("#contact-email")?.value || "",
      phone: root.querySelector("#contact-phone")?.value || ""
    },
    manufacturing: { estimatedWorkingDays: 20, estimateRangeWorkingDays: [15, 27] },
    logistics: { mode: root.querySelector("#shipping-method")?.value || "sea", estimateStatus: "indicative_pending_verified_route" }
  });
  const createServerDraft = async () => {
    if (state.serverReady && state.accessToken) return;
    try {
      const response = await fetch("/api/configuration-orders", { method:"POST", headers:{"Content-Type":"application/json"}, body:JSON.stringify({action:"create",website:""}) });
      const payload = await response.json();
      if (!response.ok || !payload.accessToken || !payload.referenceCode) throw new Error(payload.error || "draft_service_unavailable");
      state.reference = payload.referenceCode;
      state.accessToken = payload.accessToken;
      state.serverReady = true;
      root.querySelector("#reference-code").textContent = state.reference;
      root.querySelector("#reference-state").textContent = "Server draft · saved securely";
      saveDraft();
      persistServerDraft();
    } catch {
      state.serverReady = false;
      root.querySelector("#reference-state").textContent = "Local draft · not yet registered";
    }
  };
  const persistServerDraft = async () => {
    if (!state.serverReady || !state.accessToken || !state.reference.startsWith("ANV-")) return;
    try {
      await fetch("/api/configuration-orders", { method:"POST", headers:{"Content-Type":"application/json","Authorization":"Bearer "+state.accessToken}, body:JSON.stringify({action:"save",referenceCode:state.reference,configuration:collectConfiguration()}) });
    } catch {}
  };
  const updateProgress = () => {
    steps.forEach((step) => { const active = Number(step.dataset.step) === state.step; step.hidden = !active; step.classList.toggle("is-active",active); });
    labels.forEach((label) => { const n = Number(label.dataset.stepLabel); label.classList.toggle("is-current",n===state.step); label.classList.toggle("is-complete",n<state.step); });
    progressFill.style.width = (state.step/7*100)+"%";
    progressCurrent.textContent = "STEP "+String(state.step).padStart(2,"0")+" / 07";
    progressTitle.textContent = stepTitles[state.step-1];
    previous.disabled = state.step===1 || state.step===7;
    next.hidden = state.step===6 || state.step===7;
    previous.hidden = state.step===7;
    root.querySelector("#studio-controls").hidden = state.step===7;
    hint.textContent = state.step===1 ? "Choose a wheel design to continue." : state.step===2 ? "Select a make, model and year." : state.step===3 ? "Choose OEM, upgrade or custom specifications." : state.step===5 ? "Complete the required delivery and contact details." : "Review the information before continuing.";
    next.disabled = !canContinue();
    next.textContent = state.step===5 ? "Review confirmation →" : "Next step →";
    saveDraft();
  };
  const canContinue = () => {
    if(state.step===1) return Boolean(state.product);
    if(state.step===2) return Boolean(state.vehicle.make && state.vehicle.model && state.vehicle.year);
    if(state.step===3) return Boolean(state.specPath && (state.specPath==="custom" ? state.customSubmitted : state.selectedFitment));
    if(state.step===5) return ["delivery-country","delivery-city","delivery-address","contact-name","contact-email"].every(id=>root.querySelector("#"+id).value.trim());
    return [4,6].includes(state.step);
  };
  const setStep = (n) => { state.step=Math.max(1,Math.min(7,n)); updateProgress(); persistServerDraft(); if(state.step===6) buildConfirmation(); window.scrollTo({top:root.offsetTop-20,behavior:"smooth"}); };
  previous.addEventListener("click",()=>setStep(state.step-1));
  next.addEventListener("click",()=>{ if(!canContinue()) return; if(state.step===3 && state.specPath==="custom" && !state.customSubmitted){ submitCustomBrief(); return; } setStep(state.step+1); });
  root.querySelectorAll("[data-product]").forEach(button=>button.addEventListener("click",()=>{root.querySelectorAll("[data-product]").forEach(b=>b.setAttribute("aria-pressed","false"));button.setAttribute("aria-pressed","true");state.product=productRows.find(p=>p.slug===button.dataset.product);updateProgress();persistServerDraft();}));
  const catalog = async(resource,params={}) => {const q=new URLSearchParams({resource,...params});const r=await fetch("/vehicle-fitment/catalog?"+q);const data=await r.json();if(!r.ok)throw new Error(data.error||"catalog_unavailable");const rows=data?.data??data?.results??data;return Array.isArray(rows)?rows:[];};
  const dropdownHosts = [...root.querySelectorAll("[data-carbon-dropdown]")];
  const dropdownApi = new Map();
  dropdownHosts.forEach(host=>{
    const input=host.querySelector('input[type="hidden"]'),trigger=host.querySelector(".carbon-dropdown-trigger"),label=host.querySelector("[data-dropdown-label]"),menu=host.querySelector('[role="listbox"]');
    const close=()=>{menu.hidden=true;trigger.setAttribute("aria-expanded","false");host.classList.remove("is-open");};
    const render=(rows,placeholder,disabled=false)=>{menu.replaceChildren();if(!rows.some(row=>row.value===input.value))input.value="";label.textContent=placeholder;rows.forEach(row=>{const option=document.createElement("button");option.type="button";option.role="option";option.dataset.value=row.value;option.textContent=row.label;option.setAttribute("aria-selected",String(row.value===input.value));option.addEventListener("click",()=>{input.value=row.value;label.textContent=row.label;menu.querySelectorAll("button").forEach(b=>b.setAttribute("aria-selected",String(b===option)));close();input.dispatchEvent(new Event("change",{bubbles:true}));});menu.append(option);if(row.value===input.value)label.textContent=row.label;});trigger.disabled=disabled||!rows.length;host.classList.toggle("is-disabled",trigger.disabled);};
    trigger.addEventListener("click",()=>{if(trigger.disabled)return;const open=menu.hidden;document.querySelectorAll(".carbon-dropdown-menu").forEach(m=>m.hidden=true);document.querySelectorAll(".carbon-dropdown-trigger").forEach(t=>t.setAttribute("aria-expanded","false"));menu.hidden=!open;trigger.setAttribute("aria-expanded",String(open));host.classList.toggle("is-open",open);});
    document.addEventListener("click",e=>{if(!host.contains(e.target))close();});
    const initialRows=[...menu.querySelectorAll("button")].map(button=>({value:button.dataset.value,label:button.textContent.trim()}));
    render(initialRows,label.textContent,!initialRows.length);
    dropdownApi.set(input.id,{input,render,host,label,menu});
  });
  const selects = Object.fromEntries(["region","make","model","year","generation","trim"].map(k=>[k,dropdownApi.get("vehicle-"+k).input]));
  const optionValue = x => String(typeof x==="object"?(x.slug??x.id??x.code??x.value??x.year??""):x);
  const optionLabel = x => String(typeof x==="object"?(x.name??x.title??x.label??x.year??x.trim??x.slug??""):x);
  const fill = (select,rows,placeholder) => {dropdownApi.get(select.id).render(rows.map(row=>({value:optionValue(row),label:optionLabel(row)})),placeholder,!rows.length);};
  const status = root.querySelector("#vehicle-status");
  const resetVehicle = (from) => {const order=["model","year","generation","trim"];const idx=order.indexOf(from);order.slice(idx).forEach(k=>fill(selects[k],[], "Select "+k));};
  const loadMakes = async()=>{status.textContent="Loading manufacturers…";fill(selects.make,[],"Loading…");try{fill(selects.make,await catalog("makes",{region:selects.region.value}),"Select manufacturer");status.textContent="Select a manufacturer to begin.";}catch{status.textContent="Vehicle catalogue unavailable. Please try again.";fill(selects.make,[],"Catalogue unavailable");}};
  selects.region.addEventListener("change",()=>{state.vehicle.region=selects.region.value;resetVehicle("model");loadMakes();});
  selects.make.addEventListener("change",async()=>{state.vehicle.make=selects.make.value;resetVehicle("model");if(!state.vehicle.make)return;status.textContent="Loading models…";try{fill(selects.model,await catalog("models",{region:selects.region.value,make:selects.make.value}),"Select model");}catch{status.textContent="Could not load models.";}});
  selects.model.addEventListener("change",async()=>{state.vehicle.model=selects.model.value;resetVehicle("year");if(!state.vehicle.model)return;status.textContent="Loading model years and generations…";const params={region:selects.region.value,make:selects.make.value,model:selects.model.value};try{const [years,generations]=await Promise.all([catalog("years",params),catalog("generations",params)]);fill(selects.year,years,"Select year");fill(selects.generation,generations,"Optional generation");status.textContent="Select a model year. Generation and trim are optional refinements.";}catch{status.textContent="Could not load model years.";}});
  selects.year.addEventListener("change",()=>{state.vehicle.year=selects.year.value;updateVehiclePreview();});
  selects.generation.addEventListener("change",()=>{state.vehicle.generation=selects.generation.value;updateVehiclePreview();});
  selects.trim.addEventListener("change",()=>{state.vehicle.trim=selects.trim.value;updateVehiclePreview();});
  const vehicleImageCache=new Map();
  const findVehicleImage=async(make,model)=>{const key=(make+"|"+model).toLowerCase();if(vehicleImageCache.has(key))return vehicleImageCache.get(key);const task=(async()=>{const query=new URLSearchParams({action:"query",generator:"search",gsrsearch:'filetype:bitmap "'+make+" "+model+'"',gsrnamespace:"6",gsrlimit:"10",prop:"imageinfo",iiprop:"url|extmetadata",iiurlwidth:"900",format:"json",origin:"*"});const response=await fetch("https://commons.wikimedia.org/w/api.php?"+query.toString(),{headers:{Accept:"application/json"}});if(!response.ok)return null;const data=await response.json();const tokens=(make+" "+model).toLowerCase().split(/[^a-z0-9]+/).filter(Boolean);for(const page of Object.values(data?.query?.pages??{})){const title=String(page?.title??"").toLowerCase();if(!tokens.every(token=>title.includes(token)))continue;const info=page?.imageinfo?.[0];const source=info?.thumburl??info?.url;if(!source||!(source.startsWith("https://")||source.startsWith("http://")))continue;const meta=info?.extmetadata??{};const credit=[String(meta.Artist?.value??"").replace(/<[^>]*>/g," ").trim(),String(meta.LicenseShortName?.value??"")].filter(Boolean).join(" · ");return {source,credit,title:page.title};}return null;})().catch(()=>null);vehicleImageCache.set(key,task);return task;};
  const updateVehiclePreview=async()=>{const make=dropdownApi.get("vehicle-make").label.textContent,model=dropdownApi.get("vehicle-model").label.textContent;const label=[make,model,selects.year.value,dropdownApi.get("vehicle-generation").label.textContent].filter(Boolean).join(" ");root.querySelector("#vehicle-preview-title").textContent=label||"Vehicle not selected";root.querySelector("#vehicle-preview-copy").textContent="Vehicle selection saved. Fitment data will be checked against the vehicle catalogue and engineering requirements.";const art=root.querySelector(".vehicle-preview-art");art.querySelector("img")?.remove();art.querySelector(".vehicle-image-credit")?.remove();if(make&&model){const image=await findVehicleImage(make,model);if(image&&art.isConnected){const img=document.createElement("img");img.src=image.source;img.alt=label+" vehicle reference";img.loading="lazy";img.referrerPolicy="no-referrer";img.title=image.title;art.querySelector(".vehicle-silhouette")?.remove();art.append(img);if(image.credit){const credit=document.createElement("small");credit.className="vehicle-image-credit";credit.textContent="Image reference: "+image.credit;art.append(credit);}}}updateProgress();};
  const loadTrims=async()=>{if(!state.vehicle.make||!state.vehicle.model||(!state.vehicle.year&&!state.vehicle.generation))return;const p={region:selects.region.value,make:selects.make.value,model:selects.model.value};if(state.vehicle.year)p.year=state.vehicle.year;if(state.vehicle.generation)p.generation=state.vehicle.generation;try{fill(selects.trim,await catalog("modifications",p),"Optional trim");}catch{}};
  selects.year.addEventListener("change",loadTrims);selects.generation.addEventListener("change",loadTrims);
  root.querySelectorAll("[data-spec-path]").forEach(button=>button.addEventListener("click",()=>{root.querySelectorAll("[data-spec-path]").forEach(b=>b.setAttribute("aria-pressed","false"));button.setAttribute("aria-pressed","true");state.specPath=button.dataset.specPath;state.selectedFitment=null;const detail=root.querySelector("#spec-detail");detail.hidden=false;root.querySelector("#custom-spec-fields").hidden=state.specPath!=="custom";root.querySelector("#spec-reference").hidden=state.specPath==="custom";root.querySelector("#fitment-options").hidden=state.specPath==="custom";root.querySelector("#fitment-status").hidden=state.specPath==="custom";root.querySelector("#spec-detail-title").textContent=state.specPath==="oem"?"Factory specification reference":state.specPath==="upgrade"?"ANVERA upgrade reference":"Your custom specification";root.querySelector("#spec-detail-kicker").textContent=state.specPath.toUpperCase()+" / SPECIFICATION PATH";if(state.specPath!=="custom"){root.querySelector("#spec-detail-title").textContent+=" · engineering validation required";loadFitmentReferences(state.specPath);}updateProgress();}));
  const valueAt=(object,keys)=>{for(const key of keys){const value=key.split(".").reduce((v,k)=>v?.[k],object);if(value!==undefined&&value!==null&&value!=="")return value;}return null;};
  const wheelSide=(wheel,side)=>{const data=wheel?.[side]??{};return {rim:valueAt(data,["rim","rim_full","rim_size"])??valueAt(wheel,[side+"_rim"]),diameter:valueAt(data,["rim_diameter","diameter"])??valueAt(wheel,[side+"_rim_diameter"]),width:valueAt(data,["rim_width","width"])??valueAt(wheel,[side+"_rim_width"]),offset:valueAt(data,["rim_offset","offset","et"])??valueAt(wheel,[side+"_rim_offset"]),pcd:valueAt(data,["pcd","bolt_pattern"])??valueAt(wheel,["pcd","bolt_pattern"]),bore:valueAt(data,["centre_bore","center_bore","centre_bore_diameter","center_bore_diameter"])};};
  const loadFitmentReferences=async(path)=>{const status=root.querySelector("#fitment-status"),list=root.querySelector("#fitment-options");status.textContent="Retrieving original and alternative fitment records…";list.hidden=false;list.replaceChildren();try{const body={make:state.vehicle.make,model:state.vehicle.model,region:state.vehicle.region};if(state.vehicle.year)body.year=state.vehicle.year;if(state.vehicle.generation)body.generation=state.vehicle.generation;if(state.vehicle.trim)body.modification=state.vehicle.trim;const response=await fetch("/vehicle-fitment/search",{method:"POST",headers:{"Content-Type":"application/json",Accept:"application/json"},body:JSON.stringify(body)});const payload=await response.json();if(!response.ok)throw new Error(payload?.error||"fitment_search_failed");const source=payload?.result?.data??payload?.result?.results??payload?.result;const records=Array.isArray(source)?source:[];const matches=[];records.forEach(record=>{const wheels=record?.wheels??record?.fitments??record?.wheel??[];(Array.isArray(wheels)?wheels:wheels&&typeof wheels==="object"?[wheels]:[]).forEach((wheel,index)=>{const type=String(wheel?.type??wheel?.fitment_type??wheel?.kind??"");const classification=wheel?.is_stock===true||wheel?.is_oem===true||/^(oe|oem|stock|original)$/i.test(type)?"oem":wheel?.is_stock===false||wheel?.is_oem===false||/^(aftermarket|option|optional)$/i.test(type)?"aftermarket":"other";matches.push({record,wheel,index,classification,front:wheelSide(wheel,"front"),rear:wheelSide(wheel,"rear")});});});const visible=matches.filter(item=>path==="oem"?item.classification==="oem":item.classification==="aftermarket");if(!visible.length){status.textContent=path==="oem"?"No OEM-classified records were returned for this exact vehicle selection. Try another year or generation, or request engineering review.":"No aftermarket-classified records were returned for this exact vehicle selection. ANVERA engineering can prepare a bespoke upgrade reference.";return;}status.textContent=visible.length+" reference configurations returned. Select one to load its dimensions.";visible.forEach((item,index)=>{const button=document.createElement("button");button.type="button";button.className="fitment-option";button.setAttribute("aria-pressed","false");const front=item.front.rim??([item.front.width,item.front.diameter?"R"+item.front.diameter:null,item.front.offset?"ET"+item.front.offset:null].filter(Boolean).join(" × ")||"Front data unavailable");const rear=item.rear.rim??([item.rear.width,item.rear.diameter?"R"+item.rear.diameter:null,item.rear.offset?"ET"+item.rear.offset:null].filter(Boolean).join(" × ")||"Rear data unavailable");const title=document.createElement("span");const strong=document.createElement("b");strong.textContent="Configuration "+(index+1);const detail=document.createElement("small");detail.textContent="Front: "+front+" · Rear: "+rear;title.append(strong,detail);const badge=document.createElement("em");badge.textContent=item.classification.toUpperCase();button.append(title,badge);button.addEventListener("click",()=>{list.querySelectorAll("button").forEach(node=>node.setAttribute("aria-pressed",String(node===button)));state.selectedFitment=item;const pcd=valueAt(item.record?.technical??{},["bolt_pattern","pcd"])??item.front.pcd??item.rear.pcd;const bore=valueAt(item.record?.technical??{},["centre_bore","center_bore","centre_bore_diameter"])??item.front.bore??item.rear.bore;const set=(id,value)=>root.querySelector("#"+id).textContent=value??"Not supplied";set("front-diameter",item.front.diameter);set("front-width",item.front.width);set("front-pcd",pcd);set("front-offset",item.front.offset);set("front-bore",bore);set("rear-diameter",item.rear.diameter);set("rear-width",item.rear.width);set("rear-pcd",pcd);set("rear-offset",item.rear.offset);set("rear-bore",bore);status.textContent="Reference selected. Final load rating, brake clearance and hub fit still require ANVERA engineering verification.";updateProgress();});list.append(button);});}catch(error){status.textContent="Fitment lookup is unavailable for this selection. You can request an engineering review instead.";}}; 
  const submitCustomBrief=()=>{const front=root.querySelector("#custom-front").value.trim(),rear=root.querySelector("#custom-rear").value.trim();if(!front||!rear){hint.textContent="Enter both front and rear specifications before submitting.";return;}state.customSubmitted=true;root.querySelector("#spec-detail-title").textContent="Custom specification received for review";root.querySelector("#spec-detail-kicker").textContent="CUSTOM BRIEF / REVIEW REQUEST";root.querySelector("#spec-reference").hidden=true;const fields=root.querySelector("#custom-spec-fields");if(!fields.querySelector(".custom-response")){const message=document.createElement("p");message.className="custom-response";message.textContent="Thank you. Your custom specifications are ready for engineering review. ANVERA will respond within 1 business day after the brief is submitted to our team.";fields.append(message);}next.disabled=false;next.textContent="Continue to manufacturing →";hint.textContent="Custom brief prepared. Continue to review manufacturing and delivery.";saveDraft();};
  const deliveryIds=["delivery-term","shipping-method","delivery-country","delivery-region","delivery-city","delivery-postal","delivery-address","contact-name","contact-email","contact-phone"];
  deliveryIds.forEach(id=>root.querySelector("#"+id).addEventListener("input",()=>{state.delivery[id]=root.querySelector("#"+id).value;updateArrivalEstimate();updateProgress();}));
  const updateArrivalEstimate=()=>{const country=root.querySelector("#delivery-country").value.trim(),city=root.querySelector("#delivery-city").value.trim();const complete=country&&city;root.querySelector("#delivery-window").textContent=complete?"Manufacturing + route estimate pending":"Awaiting destination details";root.querySelector("#delivery-window-note").textContent=complete?"Destination captured. A verified carrier and port route is required before calculating a reliable arrival date.":"Enter destination country and city to begin the delivery estimate.";root.querySelector("#ocean-estimate").textContent=complete?"Carrier schedule required":"Route required";};
  const buildConfirmation=()=>{const v=state.vehicle;const vehicle=[dropdownApi.get("vehicle-make").label.textContent,dropdownApi.get("vehicle-model").label.textContent,v.year,v.generation,v.trim].filter(Boolean).join(" ");const spec=state.specPath==="oem"?"OEM reference":state.specPath==="upgrade"?"ANVERA upgrade reference":"Custom specification";const address=["delivery-address","delivery-city","delivery-region","delivery-postal","delivery-country"].map(id=>root.querySelector("#"+id).value.trim()).filter(Boolean).join(", ");const val=id=>root.querySelector("#"+id).value.trim()||"Not supplied";root.querySelector("#document-reference").textContent=state.reference;root.querySelector("#document-date").textContent=new Date().toLocaleDateString(undefined,{year:"numeric",month:"short",day:"numeric"});root.querySelector("#document-design").textContent=state.product?.title||"—";root.querySelector("#document-construction").textContent=state.product?.construction||"—";root.querySelector("#document-vehicle").textContent=vehicle||"—";root.querySelector("#document-vehicle-detail").textContent="Market: "+v.region;root.querySelector("#document-spec-type").textContent=spec;root.querySelector("#document-spec-details").textContent=state.specPath==="custom"?"Front: "+val("custom-front")+" / Rear: "+val("custom-rear"):"Reference values to be confirmed against verified vehicle fitment data.";root.querySelector("#document-delivery").textContent=val("delivery-term")+" / "+(val("shipping-method")==="sea"?"Sea freight":"Air freight");root.querySelector("#document-address").textContent=address;root.querySelector("#document-arrival").textContent="Estimated delivery date pending verified route calculation.";root.querySelector("#document-contact").textContent=val("contact-name");root.querySelector("#document-email").textContent=val("contact-email");root.querySelector("#document-phone").textContent=val("contact-phone");};
  root.querySelector("#download-pdf").addEventListener("click",()=>window.print());
  root.querySelector("#submit-configuration").addEventListener("click",async()=>{
    const button=root.querySelector("#submit-configuration"),status=root.querySelector("#submit-status");
    if(!state.serverReady||!state.accessToken){status.textContent="The secure order service is not available yet. Your local draft remains saved on this device.";return;}
    const customerName=root.querySelector("#contact-name").value.trim(),email=root.querySelector("#contact-email").value.trim(),phone=root.querySelector("#contact-phone").value.trim();
    if(!customerName||!email){status.textContent="Enter your contact name and email before submitting.";return;}
    // @ts-ignore Cloudflare Turnstile is injected by its external script.
    const turnstile=window.turnstile;const turnstileToken=(turnstile&&turnstile.getResponse)?turnstile.getResponse():"";
    if(!turnstileToken){status.textContent="Complete the security verification before submitting.";return;}
    button.disabled=true;status.textContent="Submitting your configuration securely…";
    try{
      const response=await fetch("/api/configuration-orders",{method:"POST",headers:{"Content-Type":"application/json","Authorization":"Bearer "+state.accessToken},body:JSON.stringify({action:"submit",referenceCode:state.reference,configuration:collectConfiguration(),customerName,email,phone,turnstileToken})});
      const payload=await response.json();
      if(!response.ok)throw new Error(payload.error||"submission_failed");
      state.submissionStatus=payload.status;state.submittedAt=new Date().toISOString();
      root.querySelector("#completion-reference").textContent=state.reference;
      root.querySelector("#track-configuration-link").href="/configuration/track?reference="+encodeURIComponent(state.reference);
      root.querySelector("#completion-status").textContent=payload.status==="custom_review"?"Your custom specification has been submitted for engineering review. ANVERA will respond within 1 business day.":"Your configuration has been submitted. ANVERA will review fitment and confirm the quotation and delivery schedule.";
      status.textContent="Configuration submitted successfully.";
      saveDraft();setStep(7);
    }catch(error){const reason=error instanceof Error?error.message:"";status.textContent=reason==="verification_not_configured"?"Secure verification is not configured on the server yet. Please contact ANVERA.":"Submission could not be completed. Your draft is still saved; please try again.";// @ts-ignore Cloudflare Turnstile is injected by its external script.
      const turnstile=window.turnstile;if(turnstile?.reset)turnstile.reset();}
    finally{button.disabled=false;}
  });
  root.querySelector("#completion-reference").textContent=state.reference;
  root.querySelector("#track-configuration-link").href="/configuration/track?reference="+encodeURIComponent(state.reference);
  if(state.product){const selected=root.querySelector(`[data-product="${CSS.escape(state.product.slug)}"]`);selected?.setAttribute("aria-pressed","true");}
  updateProgress();
  createServerDraft();
  loadMakes();
</script>

