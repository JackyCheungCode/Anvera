---
import Base from "../layouts/Base.astro";
const pillars = [
  { n:"01", title:"Material integrity", copy:"Material selection and process control form the foundation of a forged wheel programme." },
  { n:"02", title:"Design discipline", copy:"Spoke geometry, section thickness and visual balance are considered together rather than in isolation." },
  { n:"03", title:"Manufacturing control", copy:"A repeatable process, careful machining and documented inspection are essential to consistent outcomes." }
];
---
<Base title="Craftsmanship & Engineering" description="Discover the design thinking, manufacturing discipline and quality principles behind ANVERA forged wheels.">
  <section class="craft-hero">
    <div class="craft-hero-image" aria-hidden="true"><div class="craft-metal-disc"></div></div>
    <div class="craft-hero-copy">
      <p class="eyebrow">ANVERA / CRAFTSMANSHIP</p>
      <h1>Precision<br />has a form.</h1>
      <p>Forged wheel design lives at the intersection of engineering and expression. Every decision must serve the structure, the vehicle and the final visual character.</p>
    </div>
    <div class="craft-caption">ENGINEERING / MATERIAL / DETAIL</div>
  </section>
  <section class="section craft-intro">
    <div class="section-inner craft-intro-grid">
      <div><p class="section-kicker">The ANVERA approach</p><h2 class="section-title">Purpose in every<br />proportion.</h2></div>
      <p class="section-lead">We approach each wheel as a complete engineered object. Design intent is considered alongside fitment, material behaviour, manufacturing capability and inspection requirements.</p>
    </div>
  </section>
  <section class="craft-pillars">
    {pillars.map((pillar) => <article><span>{pillar.n} / PRINCIPLE</span><h3>{pillar.title}</h3><p>{pillar.copy}</p></article>)}
  </section>
  <section class="craft-quality">
    <div><p class="section-kicker">Quality is a process</p><h2>Measured.<br />Reviewed.<br />Refined.</h2></div>
    <p>Technical specifications and quality claims must be supported by actual product and factory records. ANVERA product pages will publish only verified specifications, approved finishes and validated fitment information.</p>
  </section>
  <section class="custom-cta">
    <p class="section-kicker">A project starts with a conversation</p>
    <h2>Bring your vision<br />into focus.</h2>
    <p>Tell us about your vehicle and the wheel you want to create.</p>
    <a class="cds-btn cds-btn--primary" href="/custom-inquiry">Discuss a project <span aria-hidden="true">↗</span></a>
  </section>
</Base>
