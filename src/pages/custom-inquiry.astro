---
import Base from "../layouts/Base.astro";
import TextInput from "../components/ui/TextInput.astro";
import Dropdown from "../components/ui/Dropdown.astro";
---
<Base title="Start a Custom Wheel Inquiry" description="Prepare your ANVERA forged wheel project brief with vehicle, fitment and design information.">
  <section class="inquiry-page-hero">
    <div class="inquiry-page-hero-inner">
      <p class="eyebrow">ANVERA / PROJECT INQUIRY</p>
      <h1>Start with<br /><span>the details.</span></h1>
      <p>A considered wheel project begins with a clear brief. Share what you know about your vehicle, fitment and design direction. You can leave unknown technical values blank.</p>
    </div>
  </section>
  <section class="inquiry-form-section">
    <div class="inquiry-form-intro">
      <p class="section-kicker">Project brief / 01</p>
      <h2>Tell us about<br />your vehicle.</h2>
      <p>Use this worksheet to prepare your project brief. Copy the completed summary to share with the ANVERA team.</p>
      <div class="inquiry-note"><strong>Technical note</strong><span>Fitment values are preliminary until reviewed and confirmed by our team.</span></div>
    </div>
    <form class="project-brief-form" id="project-brief-form">
      <div class="brief-form-heading"><span>01 — VEHICLE INFORMATION</span><span>REQUIRED WHERE KNOWN</span></div>
      <div class="brief-grid">
        <TextInput id="vehicle-make" name="vehicleMake" label="Vehicle make" placeholder="e.g. Porsche" required />
        <TextInput id="vehicle-model" name="vehicleModel" label="Vehicle model" placeholder="e.g. 911 Carrera" required />
        <TextInput id="vehicle-year" name="vehicleYear" label="Model year" placeholder="e.g. 2025" />
        <TextInput id="vehicle-trim" name="vehicleTrim" label="Trim / variant" placeholder="e.g. GTS, Turbo S" />
      </div>
      <div class="brief-form-heading"><span>02 — WHEEL SPECIFICATION</span><span>OPTIONAL AT THIS STAGE</span></div>
      <div class="brief-grid">
        <Dropdown id="construction" name="construction" label="Construction type" placeholder="Select construction" options={[{value:"monoblock",label:"Monoblock"},{value:"two-piece",label:"Two-piece"},{value:"three-piece",label:"Three-piece"},{value:"not-sure",label:"Not sure yet"}]} />
        <TextInput id="diameter" name="diameter" label="Diameter" placeholder="e.g. 20 inch" />
        <TextInput id="width" name="width" label="Width" placeholder="e.g. 9.5J front / 11J rear" />
        <TextInput id="pcd" name="pcd" label="PCD / bolt pattern" placeholder="e.g. 5 × 130" />
        <TextInput id="offset" name="offset" label="Offset" placeholder="e.g. ET45" />
        <TextInput id="centre-bore" name="centreBore" label="Centre bore" placeholder="If known" />
      </div>
      <div class="brief-form-heading"><span>03 — DESIGN DIRECTION</span><span>YOUR PREFERENCES</span></div>
      <div class="brief-grid">
        <Dropdown id="finish" name="finish" label="Preferred finish" placeholder="Select a direction" options={[{value:"gloss-black",label:"Gloss black"},{value:"satin-black",label:"Satin black"},{value:"brushed",label:"Brushed metal"},{value:"polished",label:"Polished"},{value:"custom",label:"Custom colour / finish"},{value:"undecided",label:"Open to suggestions"}]} />
        <Dropdown id="quantity" name="quantity" label="Quantity" placeholder="Select quantity" options={[{value:"4",label:"4 wheels"},{value:"5",label:"5 wheels"},{value:"other",label:"Other / discuss"}]} />
      </div>
      <div class="cds-field brief-notes">
        <label class="cds-label" for="project-notes">Project notes</label>
        <textarea class="cds-textarea" id="project-notes" name="projectNotes" rows="5" placeholder="Tell us about the look, intended use, brake package, references or any details that matter."></textarea>
      </div>
      <div class="brief-actions">
        <button class="cds-btn cds-btn--carbon" type="button" id="copy-project-brief">Copy project brief <span aria-hidden="true">↗</span></button>
        <button class="brief-reset" type="reset">Clear all fields</button>
      </div>
      <p class="brief-feedback" id="brief-feedback" role="status" aria-live="polite">This worksheet prepares a project summary on your device. Online inquiry delivery will be connected in the next development phase.</p>
    </form>
  </section>
</Base>
<script>
  const form = document.querySelector<HTMLFormElement>("#project-brief-form");
  const copyButton = document.querySelector<HTMLButtonElement>("#copy-project-brief");
  const feedback = document.querySelector<HTMLElement>("#brief-feedback");
  copyButton?.addEventListener("click", async () => {
    if (!form) return;
    const values = new FormData(form);
    const fields = [
      ["Vehicle make", "vehicleMake"], ["Vehicle model", "vehicleModel"], ["Model year", "vehicleYear"],
      ["Trim / variant", "vehicleTrim"], ["Construction type", "construction"], ["Diameter", "diameter"],
      ["Width", "width"], ["PCD / bolt pattern", "pcd"], ["Offset", "offset"], ["Centre bore", "centreBore"],
      ["Preferred finish", "finish"], ["Quantity", "quantity"], ["Project notes", "projectNotes"]
    ];
    const lines = ["ANVERA — CUSTOM FORGED WHEEL PROJECT BRIEF", "", ...fields.map(([label,key]) => {
      const value = String(values.get(key) || "").trim();
      return value ? label + ": " + value : "";
    }).filter(Boolean)];
    try {
      await navigator.clipboard.writeText(lines.join("\n"));
      if (feedback) feedback.textContent = "Project brief copied. You can paste it into an email or message.";
    } catch {
      if (feedback) feedback.textContent = "Clipboard access is unavailable in this browser. Please select and copy the form details manually.";
    }
  });
  form?.addEventListener("reset", () => {
    if (feedback) feedback.textContent = "This worksheet prepares a project summary on your device. Online inquiry delivery will be connected in the next development phase.";
  });
</script>
