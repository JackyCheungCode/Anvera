---
import Base from "../../layouts/Base.astro";
import Button from "../../components/ui/Button.astro";
---
<Base title="Dealer Network" description="Explore ANVERA's international dealer network and apply to become an authorised sales partner.">
  <section class="dealer-hero"><div class="dealer-hero-inner"><p class="eyebrow">ANVERA / PARTNER NETWORK</p><h1>Built on<br /><span>partnership.</span></h1><p>We welcome experienced automotive specialists who share a commitment to product knowledge, customer care and considered craftsmanship.</p><Button href="/dealers/apply" variant="primary">Apply for partnership <span aria-hidden="true">↗</span></Button></div></section>
  <section class="dealer-content"><div><p class="section-kicker">The ANVERA network</p><h2>For specialists<br />with a point of view.</h2><p>Our dealer relationships are built around regional market understanding, professional installation and clear communication. Applications are reviewed by our team before account activation.</p></div><div class="dealer-steps"><article><span>01</span><div><h3>Apply</h3><p>Share your company, market and automotive experience.</p></div></article><article><span>02</span><div><h3>Review</h3><p>Our team reviews the application and may request further information.</p></div></article><article><span>03</span><div><h3>Activation</h3><p>Approved partners receive access after administrator activation.</p></div></article></div></section>
  <section class="dealer-cta"><p class="section-kicker">Become an ANVERA partner</p><h2>Let's build<br />something lasting.</h2><Button href="/dealers/apply" variant="primary">Start your application <span aria-hidden="true">↗</span></Button></section>
</Base>
