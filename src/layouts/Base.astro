---
import { getSiteSettingsWithCacheHint } from "emdash";
import { EmDashHead, EmDashBodyStart, EmDashBodyEnd } from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import { resolveStarterSiteIdentity } from "../utils/site-identity";
import BrandLogo from "../components/BrandLogo.astro";
import "../styles/carbon.scss";
import "../styles/global.css";

interface Props {
  title: string;
  pageTitle?: string | null;
  description?: string | null;
  image?: string | null;
  canonical?: string | null;
  content?: { collection: string; id: string; slug?: string | null };
}
const { title, pageTitle, description, image, canonical, content } = Astro.props;
const settingsResult = await getSiteSettingsWithCacheHint();
if (Astro.cache?.enabled) Astro.cache.set(settingsResult.cacheHint);
const { siteTitle, siteTagline } = resolveStarterSiteIdentity(settingsResult.data);
const fullTitle = title === siteTitle || title.endsWith(` | ${siteTitle}`) || title.endsWith(` — ${siteTitle}`)
  ? title
  : `${title} — ANVERA`;
const pageDescription = description ?? siteTagline ?? "Premium forged wheels, engineered with precision and made to express individuality.";
const pageCtx = createPublicPageContext({
  Astro,
  kind: content ? "content" : "custom",
  pageType: "website",
  title: fullTitle,
  pageTitle: pageTitle ?? title,
  description: pageDescription,
  canonical,
  image,
  content,
  siteName: siteTitle || "ANVERA"
});
const navigation = [
  { label: "Configure Wheels", href: "/configure" },
  { label: "Wheels", href: "/wheels" },
  { label: "Find Your Vehicle", href: "/vehicle-fitment" },
  { label: "Customization", href: "/customization" },
  { label: "Craftsmanship", href: "/craftsmanship" },
  { label: "Gallery", href: "/gallery" },
  { label: "About", href: "/about" }
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#0b0c0e" />
  <title>{fullTitle}</title>
  <EmDashHead page={pageCtx} />
</head>
<body>
  <a class="skip-link" href="#main-content">Skip to content</a>
  <EmDashBodyStart page={pageCtx} />
  <header class="site-header">
    <div class="header-inner">
      <a class="brand-mark" href="/" aria-label="ANVERA home">
        <BrandLogo id="anvera-header" />
      </a>
      <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="primary-nav">
        <span>Menu</span>
        <span aria-hidden="true">＋</span>
      </button>
      <nav class="primary-nav" id="primary-nav" aria-label="Main navigation">
        {navigation.map((item) => <a href={item.href} aria-current={Astro.url.pathname === item.href || (item.href !== "/" && Astro.url.pathname.startsWith(`${item.href}/`)) ? "page" : undefined}>{item.label}</a>)}
        <div class="mobile-nav-actions">
          <a href="/dealers">Dealer Network</a>
          <a href="/custom-inquiry">Get a Quote ↗</a>
        </div>
      </nav>
      <div class="header-actions">
        <a class="header-utility" href="/dealers">Dealer Network</a>
        <a class="header-utility" href="/custom-inquiry">Get a Quote ↗</a>
      </div>
    </div>
  </header>
  <main id="main-content" tabindex="-1"><slot /></main>
  <footer class="site-footer">
    <div class="footer-inner">
      <a class="brand-mark" href="/" aria-label="ANVERA home">
        <BrandLogo id="anvera-footer" />
      </a>
      <div class="footer-links">
        <a href="/wheels">Wheels</a>
        <a href="/vehicle-fitment">Find Your Vehicle</a>
        <a href="/customization">Customization</a>
        <a href="/craftsmanship">Craftsmanship</a>
        <a href="/dealers/apply">Become a Dealer</a>
        <a href="/contact">Contact</a>
      </div>
    </div>
    <div class="footer-bottom">© {new Date().getFullYear()} ANVERA. FORGED TO DEFINE EXCELLENCE.</div>
  </footer>
  <EmDashBodyEnd page={pageCtx} />
  <script>
    const toggle = document.querySelector<HTMLButtonElement>(".nav-toggle");
    const nav = document.querySelector<HTMLElement>("#primary-nav");
    toggle?.addEventListener("click", () => {
      const expanded = toggle.getAttribute("aria-expanded") === "true";
      toggle.setAttribute("aria-expanded", String(!expanded));
      toggle.setAttribute("aria-label", expanded ? "Open navigation" : "Close navigation");
      nav?.classList.toggle("is-open", !expanded);
    });
    if (nav) {
      nav.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", () => {
          toggle?.setAttribute("aria-expanded", "false");
          nav.classList.remove("is-open");
          toggle?.setAttribute("aria-label", "Open navigation");
        });
      });
    }
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && nav?.classList.contains("is-open")) {
        nav.classList.remove("is-open");
        toggle?.setAttribute("aria-expanded", "false");
        toggle?.setAttribute("aria-label", "Open navigation");
        toggle?.focus();
      }
    });
  </script>
</body>
</html>
