---
interface Props { products?: Array<Record<string, unknown>> }
const { products = [] } = Astro.props;
const regions = [
  { value: "usdm", label: "USA & North America" }, { value: "cdm", label: "Canada" },
  { value: "mxndm", label: "Mexico" }, { value: "ladm", label: "Central & South America" },
  { value: "eudm", label: "Europe" }, { value: "rus", label: "Russia & CIS" },
  { value: "jdm", label: "Japan" }, { value: "chdm", label: "China" },
  { value: "skdm", label: "South Korea" }, { value: "sam", label: "Southeast Asia" },
  { value: "medm", label: "Middle East" }, { value: "nadm", label: "North Africa" },
  { value: "sadm", label: "South Africa" }, { value: "audm", label: "Oceania" }
];
const safeProducts = products.map((product) => ({
  id: String(product.id ?? ""),
  title: String(product.title ?? "ANVERA forged wheel"),
  modelCode: String(product.modelCode ?? ""),
  construction: String(product.construction ?? ""),
  finish: String(product.finish ?? ""),
  specs: product.specs && typeof product.specs === "object" ? product.specs : {}
}));
---
<section class="vehicle-finder-section">
  <div class="vehicle-finder-inner">
    <div class="vehicle-finder-heading">
      <div><p class="section-kicker">ANVERA / VEHICLE FITMENT</p><h2>Find wheels<br /><span>for your vehicle.</span></h2></div>
      <p>Choose your vehicle and market to compare original equipment and alternative fitments, then explore ANVERA forged wheel designs for your selected specification.</p>
    </div>
    <form class="vehicle-finder-form" id="vehicle-finder-form">
      <div class="vehicle-finder-grid" id="vf-vehicle-fields">
        <div class="vehicle-finder-field"><span>Market region</span><div data-dropdown="region" data-placeholder="Southeast Asia"></div></div>
        <div class="vehicle-finder-field"><span>Make</span><div data-dropdown="make" data-placeholder="Select manufacturer"></div></div>
        <div class="vehicle-finder-field"><span>Model</span><div data-dropdown="model" data-placeholder="Select model"></div></div>
        <div class="vehicle-finder-field"><span>Year</span><div data-dropdown="year" data-placeholder="Select year"></div></div>
        <div class="vehicle-finder-field"><span>Generation</span><div data-dropdown="generation" data-placeholder="Any generation"></div></div>
        <div class="vehicle-finder-field"><span>Modification / trim</span><div data-dropdown="modification" data-placeholder="All available trims"></div></div>
      </div>
      <div class="vehicle-finder-actions"><p id="vf-status" role="status" aria-live="polite">Loading vehicle catalogue…</p><button class="cds-btn cds-btn--primary" type="submit" id="vf-submit" disabled>Find fitment <span aria-hidden="true">↗</span></button></div>
    </form>
    <div class="vehicle-finder-results" id="vf-results" hidden aria-live="polite"></div>
    <p class="vehicle-finder-disclaimer">Fitment information is supplied by Wheel-Size as a reference. ANVERA will verify load rating, brake clearance, hub fit, offsets and vehicle-specific requirements before confirming any production specification.</p>
  </div>
</section>
<script define:vars={{ regionOptions: regions, anveraProducts: safeProducts }}>
  // @ts-nocheck
  const form = document.querySelector("#vehicle-finder-form");
  const status = document.querySelector("#vf-status");
  const submit = document.querySelector("#vf-submit");
  const results = document.querySelector("#vf-results");
  const values = { region: "sam", make: "", model: "", year: "", generation: "", modification: "" };
  const dropdowns = {};
  const makeLogoSlugs = {
    bmw:"bmw", mercedes:"mercedesbenz", "mercedes-benz":"mercedesbenz", audi:"audi", porsche:"porsche",
    volkswagen:"volkswagen", toyota:"toyota", lexus:"lexus", honda:"honda", nissan:"nissan",
    mazda:"mazda", subaru:"subaru", mitsubishi:"mitsubishi", ford:"ford", chevrolet:"chevrolet",
    cadillac:"cadillac", jeep:"jeep", hyundai:"hyundai", kia:"kia", genesis:"genesis",
    volvo:"volvo", jaguar:"jaguar", landrover:"landrover", "land rover":"landrover",
    ferrari:"ferrari", lamborghini:"lamborghini", maserati:"maserati", mclaren:"mclaren",
    bentley:"bentley", bugatti:"bugatti", "aston martin":"astonmartin", mini:"mini",
    infiniti:"infiniti", acura:"acura", buick:"buick", gmc:"gmc", ram:"ram"
  };
  const iconBase = "https://cdn.jsdelivr.net/npm/simple-icons@v15.15.0/icons/";
  const clean = (value) => String(value ?? "").trim();
  const rowsFrom = (payload) => {
    const source = payload?.data ?? payload?.results ?? payload;
    return Array.isArray(source) ? source : [];
  };
  const slugOf = (item) => typeof item === "string" || typeof item === "number" ? String(item) : String(item?.slug ?? item?.id ?? item?.code ?? item?.value ?? item?.year ?? "");
  const labelOf = (item) => typeof item === "string" || typeof item === "number" ? String(item) : String(item?.name ?? item?.title ?? item?.label ?? item?.year ?? item?.trim ?? item?.slug ?? "");
  const setOptions = (key, rows, placeholder, { disabled = false } = {}) => {
    dropdowns[key]?.setOptions(rows, placeholder, disabled);
  };
  const makeLogo = (label) => {
    const slug = makeLogoSlugs[clean(label).toLowerCase()];
    if (!slug) return null;
    const img = document.createElement("img");
    img.className = "vf-make-logo"; img.alt = ""; img.loading = "lazy";
    img.src = iconBase + slug + ".svg";
    img.onerror = () => img.remove();
    return img;
  };
  document.querySelectorAll("[data-dropdown]").forEach((host) => {
    const key = host.dataset.dropdown;
    const trigger = document.createElement("button");
    trigger.type = "button"; trigger.className = "vf-select-trigger";
    trigger.setAttribute("aria-haspopup", "listbox"); trigger.setAttribute("aria-expanded", "false");
    const valueLabel = document.createElement("span"); valueLabel.className = "vf-select-value";
    const chevron = document.createElement("span"); chevron.className = "vf-select-chevron"; chevron.textContent = "⌄";
    trigger.append(valueLabel, chevron);
    const menu = document.createElement("div"); menu.className = "vf-select-menu"; menu.hidden = true; menu.setAttribute("role", "listbox");
    menu.id = "vf-list-" + key; trigger.setAttribute("aria-controls", menu.id);
    host.classList.add("vf-select"); host.append(trigger, menu);
    const placeholder = host.dataset.placeholder || "Select";
    let options = [];
    const close = () => { menu.hidden = true; trigger.setAttribute("aria-expanded", "false"); };
    const render = () => {
      menu.replaceChildren();
      for (const item of options) {
        const option = document.createElement("button"); option.type = "button"; option.className = "vf-select-option";
        option.setAttribute("role", "option"); option.setAttribute("aria-selected", String(item.value === values[key]));
        if (key === "make") { const logo = makeLogo(item.label); if (logo) option.append(logo); }
        const label = document.createElement("span"); label.textContent = item.label; option.append(label);
        option.addEventListener("click", () => { values[key] = item.value; valueLabel.textContent = item.label; close(); render(); host.dispatchEvent(new CustomEvent("vf-change", { bubbles: true, detail: { key, value: item.value, item } })); });
        menu.append(option);
      }
      if (!options.length) { const empty = document.createElement("div"); empty.className = "vf-select-empty"; empty.textContent = "No options available"; menu.append(empty); }
    };
    trigger.addEventListener("click", () => { if (trigger.disabled) return; const open = menu.hidden; document.querySelectorAll(".vf-select-menu").forEach((m) => m.hidden = true); document.querySelectorAll(".vf-select-trigger").forEach((t) => t.setAttribute("aria-expanded","false")); menu.hidden = !open; trigger.setAttribute("aria-expanded", String(open)); });
    trigger.addEventListener("keydown", (event) => { if (event.key === "ArrowDown" || event.key === "Enter" || event.key === " ") { event.preventDefault(); trigger.click(); menu.querySelector("button")?.focus(); } });
    document.addEventListener("click", (event) => { if (!host.contains(event.target)) close(); });
    dropdowns[key] = {
      setOptions(items, text = placeholder, disabled = false) {
        options = (items || []).map((item) => ({ value: slugOf(item), label: labelOf(item), raw: item })).filter((item) => item.value && item.label);
        trigger.disabled = disabled || !options.length;
        trigger.classList.toggle("is-disabled", trigger.disabled);
        if (!options.some((item) => item.value === values[key])) values[key] = "";
        valueLabel.textContent = options.find((item) => item.value === values[key])?.label || text;
        render();
      },
      reset(text = placeholder, disabled = true) { options = []; values[key] = ""; valueLabel.textContent = text; trigger.disabled = disabled; trigger.classList.toggle("is-disabled", disabled); close(); render(); }
    };
    dropdowns[key].reset(placeholder, key !== "region");
  });
  const resetAfter = (key) => {
    const order = ["make","model","year","generation","modification"];
    const index = order.indexOf(key);
    order.slice(index + 1).forEach((name) => dropdowns[name].reset(document.querySelector('[data-dropdown="' + name + '"]').dataset.placeholder, true));
    submit.disabled = true;
  };
  const catalog = async (resource, params = {}) => {
    const query = new URLSearchParams({ resource, ...params });
    const response = await fetch("/vehicle-fitment/catalog?" + query.toString(), { headers: { Accept: "application/json" } });
    const payload = await response.json();
    if (!response.ok) throw new Error(payload?.error || "catalog_request_failed");
    return rowsFrom(payload);
  };
  const loadMakes = async () => {
    status.textContent = "Loading manufacturers for this market…";
    dropdowns.make.reset("Loading manufacturers", true);
    try { const rows = await catalog("makes", { region: values.region }); dropdowns.make.setOptions(rows, "Select manufacturer"); status.textContent = rows.length ? "Select a manufacturer to begin." : "No manufacturers are available for this market."; }
    catch { status.textContent = "Could not load the vehicle catalogue. Please try again."; dropdowns.make.reset("Catalogue unavailable", true); }
  };
  document.querySelector('[data-dropdown="region"]').addEventListener("vf-change", (event) => { values.region = event.detail.value; resetAfter("make"); loadMakes(); });
  document.querySelector('[data-dropdown="make"]').addEventListener("vf-change", async (event) => {
    values.make = event.detail.value; resetAfter("model"); dropdowns.model.reset("Loading models", true);
    try { const rows = await catalog("models", { region: values.region, make: values.make }); dropdowns.model.setOptions(rows, "Select model"); status.textContent = "Choose a model, then select its year or generation."; }
    catch { dropdowns.model.reset("Models unavailable", true); status.textContent = "Could not load models for this manufacturer."; }
  });
  document.querySelector('[data-dropdown="model"]').addEventListener("vf-change", async (event) => {
    values.model = event.detail.value; resetAfter("year");
    for (const key of ["year","generation"]) dropdowns[key].reset("Loading…", true);
    const params = { region: values.region, make: values.make, model: values.model };
    try {
      const [years, generations] = await Promise.all([catalog("years", params), catalog("generations", params)]);
      dropdowns.year.setOptions(years, "Select year"); dropdowns.generation.setOptions(generations, "Any generation");
      status.textContent = "Select a model year or generation. Both may be narrowed further by trim.";
    } catch { dropdowns.year.reset("Years unavailable", true); dropdowns.generation.reset("Generations unavailable", true); status.textContent = "Could not load model years or generations."; }
  });
  const loadModifications = async () => {
    if (!values.make || !values.model || (!values.year && !values.generation)) return;
    const params = { region: values.region, make: values.make, model: values.model };
    if (values.year) params.year = values.year;
    if (values.generation) params.generation = values.generation;
    try { const rows = await catalog("modifications", params); dropdowns.modification.setOptions(rows, "All available trims"); }
    catch { dropdowns.modification.reset("Trim list unavailable", true); }
    submit.disabled = !(values.year || values.generation);
  };
  for (const key of ["year","generation"]) document.querySelector('[data-dropdown="' + key + '"]').addEventListener("vf-change", (event) => {
    values[key] = event.detail.value; if (key === "year" && values.year) values.generation = ""; if (key === "generation" && values.generation) values.year = "";
    resetAfter(key); loadModifications();
  });
  document.querySelector('[data-dropdown="modification"]').addEventListener("vf-change", (event) => { values.modification = event.detail.value; });
  document.querySelector('[data-dropdown="region"]').dispatchEvent(new CustomEvent("vf-initialize"));
  dropdowns.region.setOptions(regionOptions, "Southeast Asia");
  loadMakes();

  const valueAt = (obj, paths) => { for (const path of paths) { const value = path.split(".").reduce((v,k) => v?.[k], obj); if (value !== undefined && value !== null && value !== "") return value; } return null; };
  const display = (value, suffix = "") => value === null || value === undefined || value === "" ? "—" : String(value) + suffix;
  const pairSpec = (wheel, axle) => {
    const side = wheel?.[axle] ?? {};
    return {
      rim: valueAt(side, ["rim","rim_full","rim_size"]) ?? valueAt(wheel, [axle + "_rim"]),
      diameter: valueAt(side, ["rim_diameter","diameter"]) ?? valueAt(wheel, [axle + "_rim_diameter"]),
      width: valueAt(side, ["rim_width","width"]) ?? valueAt(wheel, [axle + "_rim_width"]),
      offset: valueAt(side, ["rim_offset","offset","et"]) ?? valueAt(wheel, [axle + "_rim_offset"]),
      tire: valueAt(side, ["tire_full","tire","tire_size"]) ?? valueAt(wheel, [axle + "_tire"]),
      pcd: valueAt(side, ["pcd","bolt_pattern"]) ?? valueAt(wheel, ["pcd","bolt_pattern"]),
      centreBore: valueAt(side, ["centre_bore","center_bore","centre_bore_diameter","center_bore_diameter"])
    };
  };
  const allFitments = (record) => {
    const source = record?.wheels ?? record?.fitments ?? record?.wheel ?? [];
    const list = Array.isArray(source) ? source : source && typeof source === "object" ? [source] : [];
    return list.map((wheel, index) => ({ wheel, index, front: pairSpec(wheel,"front"), rear: pairSpec(wheel,"rear"), classification:
      wheel?.is_stock === true || wheel?.is_oem === true || /^(oe|oem|stock|original)$/i.test(String(wheel?.type ?? wheel?.fitment_type ?? wheel?.kind ?? "")) ? "oem" :
      wheel?.is_stock === false || wheel?.is_oem === false || /^(aftermarket|option|optional)$/i.test(String(wheel?.type ?? wheel?.fitment_type ?? wheel?.kind ?? "")) ? "aftermarket" : "other"
    }));
  };
  const renderSpecCell = (label, value) => { const cell = document.createElement("div"); cell.className = "vf-spec-cell"; const small = document.createElement("span"); small.textContent = label; const strong = document.createElement("strong"); strong.textContent = display(value); cell.append(small,strong); return cell; };
  const makeFitmentCard = (record, item, id, selectedId) => {
    const card = document.createElement("button"); card.type = "button"; card.className = "vf-fitment-card"; card.setAttribute("aria-pressed", String(id === selectedId));
    const top = document.createElement("div"); top.className = "vf-fitment-card-top";
    const title = document.createElement("strong"); title.textContent = "Configuration " + (item.index + 1);
    const badge = document.createElement("span"); badge.className = "vf-fitment-badge vf-fitment-badge--" + item.classification; badge.textContent = item.classification === "oem" ? "OEM / ORIGINAL" : item.classification === "aftermarket" ? "AFTERMARKET" : "UNCLASSIFIED SOURCE";
    top.append(title,badge); card.append(top);
    const grid = document.createElement("div"); grid.className = "vf-fitment-spec-grid";
    const technical = record?.technical ?? {};
    grid.append(renderSpecCell("Front wheel", item.front.rim ?? [item.front.width,item.front.diameter ? "R"+item.front.diameter : null,item.front.offset ? "ET"+item.front.offset : null].filter(Boolean).join(" × ")));
    grid.append(renderSpecCell("Rear wheel", item.rear.rim ?? [item.rear.width,item.rear.diameter ? "R"+item.rear.diameter : null,item.rear.offset ? "ET"+item.rear.offset : null].filter(Boolean).join(" × ")));
    grid.append(renderSpecCell("Front tyre", item.front.tire)); grid.append(renderSpecCell("Rear tyre", item.rear.tire));
    grid.append(renderSpecCell("PCD / Bolt pattern", valueAt(technical,["bolt_pattern","pcd"]) ?? item.front.pcd ?? item.rear.pcd));
    grid.append(renderSpecCell("Centre bore", valueAt(technical,["centre_bore","center_bore","centre_bore_diameter"]) ?? item.front.centreBore ?? item.rear.centreBore));
    grid.append(renderSpecCell("Thread / fastener", valueAt(technical,["thread_size","fastener_type","wheel_fasteners"])));
    grid.append(renderSpecCell("Wheel torque", valueAt(technical,["wheel_torque","torque"])));
    card.append(grid);
    const details = document.createElement("p"); details.className = "vf-fitment-card-note"; details.textContent = "Select this configuration to see matching ANVERA wheel designs."; card.append(details);
    card.addEventListener("click", () => { document.querySelectorAll(".vf-fitment-card").forEach((node) => { node.setAttribute("aria-pressed","false"); }); card.setAttribute("aria-pressed","true"); renderProducts(item, record); });
    return card;
  };
  const productField = (product, keys) => valueAt(product?.specs, keys) ?? valueAt(product, keys);
  const renderProducts = (fitment, record) => {
    let section = results.querySelector("#vf-products");
    if (!section) { section = document.createElement("section"); section.id = "vf-products"; section.className = "vf-products"; results.append(section); }
    section.replaceChildren();
    const heading = document.createElement("div"); heading.className = "vf-products-heading";
    const title = document.createElement("h3"); title.textContent = "ANVERA wheel recommendations";
    const intro = document.createElement("p"); intro.textContent = "Filter the collection by construction, diameter and finish. Product specifications are matched only where structured catalogue data is available.";
    heading.append(title,intro); section.append(heading);
    const controls = document.createElement("div"); controls.className = "vf-product-filters";
    const filtered = { construction: "", diameter: "", finish: "" };
    const productRows = anveraProducts.map((product) => ({...product, specs: product.specs || {}}));
    const createFilter = (key, label, options) => {
      const wrap = document.createElement("label"); wrap.className = "vf-product-filter"; const caption = document.createElement("span"); caption.textContent = label; const host = document.createElement("div"); host.className = "vf-mini-select";
      const button = document.createElement("button"); button.type = "button"; button.className = "vf-mini-trigger"; button.textContent = "All " + label.toLowerCase() + "s  ⌄";
      const menu = document.createElement("div"); menu.className = "vf-mini-menu"; menu.hidden = true;
      const choices = ["All",...options.filter(Boolean)];
      choices.forEach((choice) => { const option = document.createElement("button"); option.type = "button"; option.textContent = choice; option.addEventListener("click", () => { filtered[key] = choice === "All" ? "" : choice; button.textContent = (choice === "All" ? "All " + label.toLowerCase() + "s" : choice) + "  ⌄"; menu.hidden = true; paint(); }); menu.append(option); });
      button.addEventListener("click", () => { menu.hidden = !menu.hidden; }); host.append(button,menu); wrap.append(caption,host); controls.append(wrap);
    };
    const unique = (key) => [...new Set(productRows.map((p) => clean(productField(p,key))).filter(Boolean))].sort();
    createFilter("construction","Construction",unique(["construction","construction_type"]));
    createFilter("diameter","Diameter",unique(["diameter","rim_diameter"]));
    createFilter("finish","Finish",unique(["finish","finish_name"]));
    section.append(controls);
    const list = document.createElement("div"); list.className = "vf-product-grid"; section.append(list);
    const paint = () => {
      list.replaceChildren();
      const compatible = productRows.filter((product) => {
        const construction = clean(productField(product,["construction","construction_type"]));
        const diameter = clean(productField(product,["diameter","rim_diameter"]));
        const finish = clean(productField(product,["finish","finish_name"]));
        return (!filtered.construction || construction === filtered.construction) && (!filtered.diameter || diameter === filtered.diameter) && (!filtered.finish || finish === filtered.finish);
      });
      if (!compatible.length) { const empty = document.createElement("p"); empty.className = "vf-product-empty"; empty.textContent = "No published ANVERA products match these filters."; list.append(empty); return; }
      compatible.forEach((product) => {
        const article = document.createElement("article"); article.className = "vf-product-card";
        const meta = document.createElement("div"); meta.className = "vf-product-meta"; meta.textContent = [product.modelCode,product.construction].filter(Boolean).join(" / ").toUpperCase() || "ANVERA / FORGED";
        const name = document.createElement("h4"); name.textContent = product.title;
        const specs = document.createElement("p"); specs.className = "vf-product-specs"; specs.textContent = [productField(product,["diameter","rim_diameter"]) ? "Ø"+productField(product,["diameter","rim_diameter"]) : "",productField(product,["width","rim_width"]) ? productField(product,["width","rim_width"])+"J" : "",productField(product,["pcd"]) ? "PCD "+productField(product,["pcd"]) : "",productField(product,["offset","et"]) ? "ET "+productField(product,["offset","et"]) : ""].filter(Boolean).join(" · ") || "Specifications available on request";
        const finish = document.createElement("p"); finish.className = "vf-product-finish"; finish.textContent = product.finish ? "Finish · " + product.finish : "Custom finish options";
        const link = document.createElement("a"); link.href = "/wheels/models/" + encodeURIComponent(product.id); link.textContent = "Explore design ↗";
        article.append(meta,name,specs,finish,link); list.append(article);
      });
    };
    paint();
  };
  form.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!values.make || !values.model || (!values.year && !values.generation)) return;
    submit.disabled = true; status.textContent = "Searching original and alternative fitment records…"; results.hidden = true; results.replaceChildren();
    const body = { make: values.make, model: values.model, region: values.region };
    if (values.year) body.year = values.year; if (values.generation) body.generation = values.generation; if (values.modification) body.modification = values.modification;
    try {
      const response = await fetch("/vehicle-fitment/search", { method: "POST", headers: { "Content-Type": "application/json", Accept: "application/json" }, body: JSON.stringify(body) });
      const payload = await response.json(); if (!response.ok) throw new Error(payload?.error || "fitment_search_failed");
      const records = rowsFrom(payload?.result);
      const intro = document.createElement("div"); intro.className = "vf-results-heading";
      const title = document.createElement("h3"); title.textContent = "Vehicle fitment results";
      const count = document.createElement("p"); count.textContent = records.length + " vehicle record(s) returned. Choose a specific wheel configuration below.";
      intro.append(title,count); results.append(intro);
      let selected = null;
      const groups = { oem: [], aftermarket: [], other: [] };
      records.forEach((record) => allFitments(record).forEach((fitment) => groups[fitment.classification].push({record,fitment})));
      const renderGroup = (key,label,description) => {
        const entries = groups[key]; if (!entries.length) return;
        const group = document.createElement("section"); group.className = "vf-fitment-group";
        const head = document.createElement("div"); head.className = "vf-fitment-group-heading";
        const h = document.createElement("h4"); h.textContent = label; const p = document.createElement("p"); p.textContent = description; head.append(h,p); group.append(head);
        entries.forEach(({record,fitment}) => { const card = makeFitmentCard(record,fitment, key+":"+fitment.index, selected); group.append(card); });
        results.append(group);
      };
      renderGroup("oem","Original equipment (OEM)","Factory-fitted wheel and tyre configurations supplied for this vehicle.");
      renderGroup("aftermarket","Aftermarket & optional fitments","Alternative or manufacturer-optional configurations returned by the fitment source.");
      renderGroup("other","Additional records","The source did not provide an explicit OEM / aftermarket classification for these records.");
      if (!Object.values(groups).some((list) => list.length)) { const empty = document.createElement("p"); empty.className = "vf-product-empty"; empty.textContent = "No wheel configurations were returned for this vehicle selection. Try another year, generation or market."; results.append(empty); }
      results.hidden = false; status.textContent = records.length ? "Fitment data loaded. Select a configuration to view ANVERA products." : "No fitment records found.";
    } catch (error) { status.textContent = "Fitment lookup failed. Please review your selection and try again."; }
    finally { submit.disabled = false; }
  });
</script>
<style>
.vehicle-finder-section{padding:clamp(64px,8vw,112px) var(--page-gutter);background:#f1f2f3}
.vehicle-finder-inner{width:min(100%,var(--content-max));margin:auto}
.vehicle-finder-heading{display:flex;justify-content:space-between;align-items:end;gap:48px;margin-bottom:44px}
.vehicle-finder-heading h2{margin:14px 0 0;font-family:var(--font-display);font-size:clamp(38px,5.5vw,68px);line-height:.95;letter-spacing:-.045em;text-transform:uppercase}
.vehicle-finder-heading h2 span{color:var(--anvera-red)}
.vehicle-finder-heading>p{max-width:430px;margin:0 0 4px;color:var(--cds-text-secondary);font-size:14px;line-height:1.8}
.vehicle-finder-form{padding:30px;background:#fff}
.vehicle-finder-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:22px}
.vehicle-finder-field{display:grid;gap:8px;min-width:0;color:var(--cds-text-secondary);font-size:11px;font-weight:700;letter-spacing:.1em;text-transform:uppercase}
.vf-select{position:relative;min-width:0}
