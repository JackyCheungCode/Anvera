---
interface Props { products?: Array<Record<string, unknown>>; compact?: boolean; resultsTarget?: string }
const { products = [], compact = false, resultsTarget = "" } = Astro.props;
const regions = [
  { value: "usdm", label: "USA & North America" }, { value: "cdm", label: "Canada" },
  { value: "mxndm", label: "Mexico" }, { value: "ladm", label: "Central & South America" },
  { value: "eudm", label: "Europe" }, { value: "rus", label: "Russia & CIS" },
  { value: "jdm", label: "Japan" }, { value: "chdm", label: "China" },
  { value: "skdm", label: "South Korea" }, { value: "sam", label: "Southeast Asia" },
  { value: "medm", label: "Middle East" }, { value: "nadm", label: "North Africa" },
  { value: "sadm", label: "South Africa" }, { value: "audm", label: "Oceania" }
];
const safeProducts = products.map((product) => ({
  id: String(product.id ?? ""),
  title: String(product.title ?? "ANVERA forged wheel"),
  modelCode: String(product.modelCode ?? ""),
  construction: String(product.construction ?? ""),
  finish: String(product.finish ?? ""),
  finishes: Array.isArray(product.finishes) ? product.finishes.map(String) : [],
  specs: product.specs && typeof product.specs === "object" ? product.specs : {},
  verifiedFitments: Array.isArray(product.verifiedFitments) ? product.verifiedFitments : []
}));
---
<section class:list={["vehicle-finder-section", compact && "vehicle-finder-section--compact"]}>
  <div class="vehicle-finder-inner">
    {!compact && <div class="vehicle-finder-heading">
      <div><p class="section-kicker">ANVERA / VEHICLE FITMENT</p><h2>Find wheels<br /><span>for your vehicle.</span></h2></div>
      <p>Choose your vehicle and market to compare original equipment and alternative fitments, then explore ANVERA forged wheel designs for your selected specification.</p>
    </div>}
    <form class="vehicle-finder-form" id="vehicle-finder-form">
      <div class="vehicle-finder-grid" id="vf-vehicle-fields">
        <div class="vehicle-finder-field"><span>Market region</span><div data-dropdown="region" data-placeholder="Southeast Asia"></div></div>
        <div class="vehicle-finder-field"><span>Make</span><div data-dropdown="make" data-placeholder="Select manufacturer"></div></div>
        <div class="vehicle-finder-field"><span>Model</span><div data-dropdown="model" data-placeholder="Select model"></div></div>
        <div class="vehicle-finder-field"><span>Year</span><div data-dropdown="year" data-placeholder="Select year"></div></div>
        <div class="vehicle-finder-field"><span>Generation</span><div data-dropdown="generation" data-placeholder="Any generation"></div></div>
        <div class="vehicle-finder-field"><span>Modification / trim</span><div data-dropdown="modification" data-placeholder="All available trims"></div></div>
      </div>
      <div class="vehicle-finder-actions"><p id="vf-status" role="status" aria-live="polite">Loading vehicle catalogue…</p><button class="cds-btn cds-btn--primary" type="submit" id="vf-submit" disabled>Find fitment <span aria-hidden="true">↗</span></button></div>
    </form>
    <div class="vehicle-finder-results" id="vf-results" hidden aria-live="polite"></div>
    {!compact && <p class="vehicle-finder-disclaimer">Fitment information is supplied by Wheel-Size as a reference. ANVERA will verify load rating, brake clearance, hub fit, offsets and vehicle-specific requirements before confirming any production specification.</p>}
  </div>
</section>
<script define:vars={{ regionOptions: regions, anveraProducts: safeProducts, compactMode: compact, resultsTargetId: resultsTarget }}>
  // @ts-nocheck
  const form = document.querySelector("#vehicle-finder-form");
  const status = document.querySelector("#vf-status");
  const submit = document.querySelector("#vf-submit");
  const results = document.querySelector("#vf-results");
  if (resultsTargetId) {
    const resultsTarget = document.getElementById(resultsTargetId);
    if (resultsTarget && results) resultsTarget.append(results);
  }
  const values = { region: "sam", make: "", model: "", year: "", generation: "", modification: "" };
  const dropdowns = {};
  let selectedMakeLabel = "";
  let selectedModelLabel = "";
  const notifyVehicleChange = () => window.dispatchEvent(new CustomEvent("anvera:vehicle-change", { detail: { ...values, makeLabel: selectedMakeLabel, modelLabel: selectedModelLabel } }));
  const vehicleImageCache = new Map();
  const makeLogoSlugs = {
    bmw:"bmw", mercedes:"mercedesbenz", "mercedes-benz":"mercedesbenz", audi:"audi", porsche:"porsche",
    abarth:"abarth", "alfa romeo":"alfaromeo", alpine:"alpine", aston:"astonmartin", citroen:"citroen", dacia:"dacia", dodge:"dodge", fiat:"fiat", isuzu:"isuzu", lotus:"lotus", mg:"mg", opel:"opel", peugeot:"peugeot", polestar:"polestar", renault:"renault", rivian:"rivian", skoda:"skoda", smart:"smart", suzuki:"suzuki", tesla:"tesla",
    volkswagen:"volkswagen", toyota:"toyota", lexus:"lexus", honda:"honda", nissan:"nissan",
    mazda:"mazda", subaru:"subaru", mitsubishi:"mitsubishi", ford:"ford", chevrolet:"chevrolet",
    cadillac:"cadillac", jeep:"jeep", hyundai:"hyundai", kia:"kia", genesis:"genesis",
    volvo:"volvo", jaguar:"jaguar", landrover:"landrover", "land rover":"landrover",
    ferrari:"ferrari", lamborghini:"lamborghini", maserati:"maserati", mclaren:"mclaren",
    bentley:"bentley", bugatti:"bugatti", "aston martin":"astonmartin", mini:"mini",
    infiniti:"infiniti", acura:"acura", buick:"buick", gmc:"gmc", ram:"ram"
  };
  const iconBase = "https://cdn.jsdelivr.net/npm/simple-icons@v15.15.0/icons/";
  const clean = (value) => String(value ?? "").trim();
  const rowsFrom = (payload) => {
    const source = payload?.data ?? payload?.results ?? payload;
    return Array.isArray(source) ? source : [];
  };
  const slugOf = (item) => typeof item === "string" || typeof item === "number" ? String(item) : String(item?.slug ?? item?.id ?? item?.code ?? item?.value ?? item?.year ?? "");
  const labelOf = (item) => typeof item === "string" || typeof item === "number" ? String(item) : String(item?.name ?? item?.title ?? item?.label ?? item?.year ?? item?.trim ?? item?.slug ?? "");
  const setOptions = (key, rows, placeholder, { disabled = false } = {}) => {
    dropdowns[key]?.setOptions(rows, placeholder, disabled);
  };
  const makeLogo = (label, raw) => {
    const imageValue = raw?.logo ?? raw?.logo_url ?? raw?.image_url ?? raw?.image ?? raw?.icon ?? null;
    const source = typeof imageValue === "string" ? imageValue : imageValue?.url ?? imageValue?.src ?? null;
    const slug = makeLogoSlugs[clean(label).toLowerCase()];
    if (!source && !slug) return null;
    const img = document.createElement("img");
    img.className = "vf-make-logo"; img.alt = ""; img.loading = "lazy"; img.decoding = "async";
    img.src = source || (iconBase + slug + ".svg");
    img.onerror = () => { if (source && slug) { img.src = iconBase + slug + ".svg"; } else img.remove(); };
    return img;
  };
  const normalizedWords = (value) => clean(value).toLowerCase().replace(/[^a-z0-9]+/g, " ").trim().split(/\s+/).filter(Boolean);
  const commonsVehicleImage = async (make, model) => {
    const cacheKey = (make + "|" + model).toLowerCase();
    if (vehicleImageCache.has(cacheKey)) return vehicleImageCache.get(cacheKey);
    const lookup = (async () => {
      if (!make || !model) return null;
      const params = new URLSearchParams({
        action: "query", generator: "search", gsrsearch: 'filetype:bitmap "' + make + " " + model + '"',
        gsrnamespace: "6", gsrlimit: "12", prop: "imageinfo", iiprop: "url|extmetadata",
        iiurlwidth: "180", format: "json", origin: "*"
      });
      const response = await fetch("https://commons.wikimedia.org/w/api.php?" + params.toString(), { headers: { Accept: "application/json" } });
      if (!response.ok) return null;
      const payload = await response.json();
      const requiredTokens = [...normalizedWords(make), ...normalizedWords(model)];
      const pages = Object.values(payload?.query?.pages ?? {});
      for (const page of pages) {
        const titleWords = new Set(normalizedWords(page?.title));
        if (!requiredTokens.every((token) => titleWords.has(token))) continue;
        const info = page?.imageinfo?.[0];
        const source = info?.thumburl ?? info?.url;
        if (!source || !/^https?:\/\//i.test(source)) continue;
        const metadata = info?.extmetadata ?? {};
        const artist = clean(metadata?.Artist?.value).replace(/<[^>]*>/g, " ").replace(/\s+/g, " ").trim();
        const license = clean(metadata?.LicenseShortName?.value);
        return { source, title: [page.title, artist, license].filter(Boolean).join(" — ") };
      }
      return null;
    })().catch(() => null);
    vehicleImageCache.set(cacheKey, lookup);
    return lookup;
  };
  const modelImage = (raw, modelLabel) => {
    const frame = document.createElement("span"); frame.className = "vf-model-image-frame";
    const loadImage = () => commonsVehicleImage(selectedMakeLabel, modelLabel).then((image) => {
      if (!image || !frame.isConnected) { if (frame.isConnected) frame.remove(); return; }
      const img = document.createElement("img"); img.className = "vf-model-image"; img.alt = "";
      img.loading = "lazy"; img.decoding = "async"; img.src = image.source; img.title = image.title;
      img.onerror = () => frame.remove(); frame.append(img);
    });
    queueMicrotask(() => {
      if (!frame.isConnected) return;
      if ("IntersectionObserver" in window) {
        const observer = new IntersectionObserver((entries) => {
          if (entries.some((entry) => entry.isIntersecting)) { observer.disconnect(); loadImage(); }
        }, { root: frame.closest(".vf-select-menu") });
        observer.observe(frame);
      } else loadImage();
    });
    return frame;
  };
  const renderSelectedValue = (valueLabel, key, item, label) => {
    valueLabel.replaceChildren();
    if (key === "make") { const logo = makeLogo(label, item?.raw); if (logo) valueLabel.append(logo); }
    if (key === "model" && !compactMode) { const image = modelImage(item?.raw, label); if (image) valueLabel.append(image); }
    const text = document.createElement("span"); text.className = "vf-select-value-text"; text.textContent = label; valueLabel.append(text);
  };
  document.querySelectorAll("[data-dropdown]").forEach((host) => {
    const key = host.dataset.dropdown;
    const trigger = document.createElement("button");
    trigger.type = "button"; trigger.className = "vf-select-trigger";
    trigger.setAttribute("aria-haspopup", "listbox"); trigger.setAttribute("aria-expanded", "false");
    const valueLabel = document.createElement("span"); valueLabel.className = "vf-select-value";
    const chevron = document.createElement("span"); chevron.className = "vf-select-chevron"; chevron.textContent = "⌄";
    trigger.append(valueLabel, chevron);
    const menu = document.createElement("div"); menu.className = "vf-select-menu"; menu.hidden = true; menu.setAttribute("role", "listbox");
    menu.id = "vf-list-" + key; trigger.setAttribute("aria-controls", menu.id);
    host.classList.add("vf-select"); host.append(trigger, menu);
    const placeholder = host.dataset.placeholder || "Select";
    let options = [];
    const close = () => { menu.hidden = true; trigger.setAttribute("aria-expanded", "false"); };
    const render = () => {
      menu.replaceChildren();
      for (const item of options) {
        const option = document.createElement("button"); option.type = "button"; option.className = "vf-select-option";
        option.setAttribute("role", "option"); option.setAttribute("aria-selected", String(item.value === values[key]));
        if (key === "make") { const logo = makeLogo(item.label, item.raw); if (logo) option.append(logo); }
        if (key === "model" && !compactMode) { const image = modelImage(item.raw, item.label); if (image) option.append(image); }
        const label = document.createElement("span"); label.textContent = item.label; option.append(label);
        option.addEventListener("click", () => { values[key] = item.value; renderSelectedValue(valueLabel, key, item, item.label); close(); render(); host.dispatchEvent(new CustomEvent("vf-change", { bubbles: true, detail: { key, value: item.value, item } })); });
        menu.append(option);
      }
      if (!options.length) { const empty = document.createElement("div"); empty.className = "vf-select-empty"; empty.textContent = "No options available"; menu.append(empty); }
    };
    trigger.addEventListener("click", () => { if (trigger.disabled) return; const open = menu.hidden; document.querySelectorAll(".vf-select-menu").forEach((m) => m.hidden = true); document.querySelectorAll(".vf-select-trigger").forEach((t) => t.setAttribute("aria-expanded","false")); menu.hidden = !open; trigger.setAttribute("aria-expanded", String(open)); });
    trigger.addEventListener("keydown", (event) => { if (event.key === "ArrowDown" || event.key === "Enter" || event.key === " ") { event.preventDefault(); trigger.click(); menu.querySelector("button")?.focus(); } });
    document.addEventListener("click", (event) => { if (!host.contains(event.target)) close(); });
    dropdowns[key] = {
      setOptions(items, text = placeholder, disabled = false) {
        options = (items || []).map((item) => ({ value: slugOf(item), label: labelOf(item), raw: item })).filter((item) => item.value && item.label);
        trigger.disabled = disabled || !options.length;
        trigger.classList.toggle("is-disabled", trigger.disabled);
        if (!options.some((item) => item.value === values[key])) values[key] = "";
        const selected = options.find((item) => item.value === values[key]);
        if (selected) renderSelectedValue(valueLabel, key, selected, selected.label);
        else valueLabel.textContent = text;
        render();
      },
      reset(text = placeholder, disabled = true) { options = []; values[key] = ""; valueLabel.textContent = text; trigger.disabled = disabled; trigger.classList.toggle("is-disabled", disabled); close(); render(); }
    };
    dropdowns[key].reset(placeholder, key !== "region");
  });
  const resetAfter = (key) => {
    const order = ["make","model","year","generation","modification"];
    const index = order.indexOf(key);
    order.slice(index + 1).forEach((name) => dropdowns[name].reset(document.querySelector('[data-dropdown="' + name + '"]').dataset.placeholder, true));
    submit.disabled = true;
  };
  const catalog = async (resource, params = {}) => {
    const query = new URLSearchParams({ resource, ...params });
    const response = await fetch("/vehicle-fitment/catalog?" + query.toString(), { headers: { Accept: "application/json" } });
    const payload = await response.json();
    if (!response.ok) throw new Error(payload?.error || "catalog_request_failed");
    return rowsFrom(payload);
  };
  const loadMakes = async () => {
    status.textContent = "Loading manufacturers for this market…";
    dropdowns.make.reset("Loading manufacturers", true);
    try { const rows = await catalog("makes", { region: values.region }); dropdowns.make.setOptions(rows, "Select manufacturer"); status.textContent = rows.length ? "Select a manufacturer to begin." : "No manufacturers are available for this market."; }
    catch { status.textContent = "Could not load the vehicle catalogue. Please try again."; dropdowns.make.reset("Catalogue unavailable", true); }
  };
  document.querySelector('[data-dropdown="region"]').addEventListener("vf-change", (event) => { values.region = event.detail.value; selectedMakeLabel = ""; selectedModelLabel = ""; resetAfter("make"); notifyVehicleChange(); loadMakes(); });
  document.querySelector('[data-dropdown="make"]').addEventListener("vf-change", async (event) => {
    values.make = event.detail.value; selectedMakeLabel = event.detail.item?.label ?? event.detail.value; selectedModelLabel = ""; resetAfter("model"); notifyVehicleChange(); dropdowns.model.reset("Loading models", true);
    try { const rows = await catalog("models", { region: values.region, make: values.make }); dropdowns.model.setOptions(rows, "Select model"); status.textContent = "Choose a model, then select its year or generation."; }
    catch { dropdowns.model.reset("Models unavailable", true); status.textContent = "Could not load models for this manufacturer."; }
  });
  document.querySelector('[data-dropdown="model"]').addEventListener("vf-change", async (event) => {
    values.model = event.detail.value; selectedModelLabel = event.detail.item?.label ?? event.detail.value; resetAfter("year"); notifyVehicleChange();
    for (const key of ["year","generation"]) dropdowns[key].reset("Loading…", true);
    const params = { region: values.region, make: values.make, model: values.model };
    try {
      const [years, generations] = await Promise.all([catalog("years", params), catalog("generations", params)]);
      dropdowns.year.setOptions(years, "Select year"); dropdowns.generation.setOptions(generations, "Any generation");
      status.textContent = "Select a model year or generation. Both may be narrowed further by trim.";
    } catch { dropdowns.year.reset("Years unavailable", true); dropdowns.generation.reset("Generations unavailable", true); status.textContent = "Could not load model years or generations."; }
  });
  const loadModifications = async () => {
    if (!values.make || !values.model || (!values.year && !values.generation)) return;
    const params = { region: values.region, make: values.make, model: values.model };
    if (values.year) params.year = values.year;
    if (values.generation) params.generation = values.generation;
    try { const rows = await catalog("modifications", params); dropdowns.modification.setOptions(rows, "All available trims"); }
    catch { dropdowns.modification.reset("Trim list unavailable", true); }
    submit.disabled = !(values.year || values.generation);
  };
  for (const key of ["year","generation"]) document.querySelector('[data-dropdown="' + key + '"]').addEventListener("vf-change", (event) => {
    values[key] = event.detail.value;
    resetAfter(key); notifyVehicleChange(); loadModifications();
  });
  document.querySelector('[data-dropdown="modification"]').addEventListener("vf-change", (event) => { values.modification = event.detail.value; notifyVehicleChange(); });
  document.querySelector('[data-dropdown="region"]').dispatchEvent(new CustomEvent("vf-initialize"));
  dropdowns.region.setOptions(regionOptions, "Southeast Asia");
  loadMakes();

  const valueAt = (obj, paths) => { for (const path of paths) { const value = path.split(".").reduce((v,k) => v?.[k], obj); if (value !== undefined && value !== null && value !== "") return value; } return null; };
  const display = (value, suffix = "") => value === null || value === undefined || value === "" ? "—" : String(value) + suffix;
  const pairSpec = (wheel, axle) => {
    const side = wheel?.[axle] ?? {};
    return {
      rim: valueAt(side, ["rim","rim_full","rim_size"]) ?? valueAt(wheel, [axle + "_rim"]),
      diameter: valueAt(side, ["rim_diameter","diameter"]) ?? valueAt(wheel, [axle + "_rim_diameter"]),
      width: valueAt(side, ["rim_width","width"]) ?? valueAt(wheel, [axle + "_rim_width"]),
      offset: valueAt(side, ["rim_offset","offset","et"]) ?? valueAt(wheel, [axle + "_rim_offset"]),
      tire: valueAt(side, ["tire_full","tire","tire_size"]) ?? valueAt(wheel, [axle + "_tire"]),
      pcd: valueAt(side, ["pcd","bolt_pattern"]) ?? valueAt(wheel, ["pcd","bolt_pattern"]),
      centreBore: valueAt(side, ["centre_bore","center_bore","centre_bore_diameter","center_bore_diameter"])
    };
  };
  const allFitments = (record) => {
    const source = record?.wheels ?? record?.fitments ?? record?.wheel ?? [];
    const list = Array.isArray(source) ? source : source && typeof source === "object" ? [source] : [];
    return list.map((wheel, index) => ({ wheel, index, front: pairSpec(wheel,"front"), rear: pairSpec(wheel,"rear"), classification:
      wheel?.is_stock === true || wheel?.is_oem === true || /^(oe|oem|stock|original)$/i.test(String(wheel?.type ?? wheel?.fitment_type ?? wheel?.kind ?? "")) ? "oem" :
      wheel?.is_stock === false || wheel?.is_oem === false || /^(aftermarket|option|optional)$/i.test(String(wheel?.type ?? wheel?.fitment_type ?? wheel?.kind ?? "")) ? "aftermarket" : "other"
    }));
  };
  const renderSpecCell = (label, value) => { const cell = document.createElement("div"); cell.className = "vf-spec-cell"; const small = document.createElement("span"); small.textContent = label; const strong = document.createElement("strong"); strong.textContent = display(value); cell.append(small,strong); return cell; };
  const makeFitmentRow = (record, item, id, selectedId) => {
    const row = document.createElement("tr"); row.className = "vf-fitment-row"; row.dataset.fitmentId = id; row.setAttribute("aria-selected",String(id === selectedId));
    const cells = [
      ["Configuration", "Configuration " + (item.index + 1)],
      ["Front wheel", item.front.rim ?? [item.front.width,item.front.diameter ? "R"+item.front.diameter : null,item.front.offset ? "ET"+item.front.offset : null].filter(Boolean).join(" × ")],
      ["Rear wheel", item.rear.rim ?? [item.rear.width,item.rear.diameter ? "R"+item.rear.diameter : null,item.rear.offset ? "ET"+item.rear.offset : null].filter(Boolean).join(" × ")],
      ["Front tyre", item.front.tire], ["Rear tyre", item.rear.tire],
      ["PCD", valueAt(record?.technical ?? {},["bolt_pattern","pcd"]) ?? item.front.pcd ?? item.rear.pcd],
      ["Centre bore", valueAt(record?.technical ?? {},["centre_bore","center_bore","centre_bore_diameter"]) ?? item.front.centreBore ?? item.rear.centreBore],
      ["Fastener", valueAt(record?.technical ?? {},["thread_size","fastener_type","wheel_fasteners"])],
      ["Torque", valueAt(record?.technical ?? {},["wheel_torque","torque"])]
    ];
    cells.forEach(([label,value],index) => { const cell=document.createElement("td"); if(index===0){const title=document.createElement("strong");title.textContent=value;const badge=document.createElement("span");badge.className="vf-fitment-badge vf-fitment-badge--"+item.classification;badge.textContent=item.classification==="oem"?"OEM":item.classification==="aftermarket"?"AFTERMARKET":"UNCLASSIFIED";cell.append(title,badge);}else{const span=document.createElement("span");span.className="vf-table-cell-label";span.textContent=label;const text=document.createElement("strong");text.textContent=display(value);cell.append(span,text);} row.append(cell);});
    const actionCell=document.createElement("td");actionCell.className="vf-fitment-action-cell";const choose=document.createElement("button");choose.type="button";choose.className="cds-btn cds-btn--secondary vf-choose-fitment";choose.textContent=id===selectedId?"Selected":"Select";choose.setAttribute("aria-label","Select "+cells[0][1]);actionCell.append(choose);row.append(actionCell);
    const select=()=>{document.querySelectorAll(".vf-fitment-row").forEach((node)=>{node.setAttribute("aria-selected","false");const button=node.querySelector(".vf-choose-fitment");if(button)button.textContent="Select";});row.setAttribute("aria-selected","true");choose.textContent="Selected";if(!compactMode)renderProducts(item,record);else status.textContent="Fitment selected. Review your wheel specification below.";window.dispatchEvent(new CustomEvent("anvera:fitment-selected",{detail:{record,fitment:item,vehicle:{...values}}}));};
    row.addEventListener("click",select);choose.addEventListener("click",(event)=>{event.stopPropagation();select();});return row;
  };
  const productValues = (product, keys) => {
    const found = [];
    const direct = valueAt(product?.specs, keys) ?? valueAt(product, keys);
    if (Array.isArray(direct)) found.push(...direct); else if (direct !== null && direct !== undefined && direct !== "") found.push(direct);
    if (keys.some((key) => key === "finish" || key === "finish_name")) found.push(...(product.finishes || []));
    for (const approved of product.verifiedFitments || []) for (const axle of ["front","rear"]) {
      const value = valueAt(approved?.[axle], keys);
      if (value !== null && value !== undefined && value !== "") found.push(value);
    }
    return [...new Set(found.map(clean).filter(Boolean))];
  };
  const productField = (product, keys) => productValues(product, keys)[0] ?? null;
  const numeric = (value) => { const match = String(value ?? "").match(/-?\\d+(?:\\.\\d+)?/); return match ? Number(match[0]) : null; };
  const normalizePcd = (value) => clean(value).toLowerCase().replace(/\s+/g,"").replace(/x/g,"×");
  const fitmentMatchesProduct = (fitment, record, product) => {
    const technical = record?.technical ?? {};
    const vehiclePcd = valueAt(technical,["bolt_pattern","pcd"]) ?? fitment.front.pcd ?? fitment.rear.pcd;
    const vehicleBore = valueAt(technical,["centre_bore","center_bore","centre_bore_diameter"]) ?? fitment.front.centreBore ?? fitment.rear.centreBore;
    const productFitments = product.verifiedFitments || [];
    if (!productFitments.length) return "review";
    const vehicleMake = clean(record?.make?.name).toLowerCase();
    const vehicleModel = clean(record?.model?.name).toLowerCase();
    const selectedYear = numeric(record?.year ?? values.year);
    const matched = productFitments.some((approved) => {
      if (approved.vehicleMake && vehicleMake && approved.vehicleMake.toLowerCase() !== vehicleMake) return false;
      if (approved.vehicleModel && vehicleModel && approved.vehicleModel.toLowerCase() !== vehicleModel) return false;
      const from = numeric(approved.modelYearFrom), to = numeric(approved.modelYearTo);
      if (selectedYear !== null && ((from !== null && selectedYear < from) || (to !== null && selectedYear > to))) return false;
      let pcdMatched = false, diameterMatched = false, hasConflict = false;
      for (const axle of ["front","rear"]) {
        const vehicle = fitment[axle] || {};
        const wheel = approved[axle] || {};
        const pcd = valueAt(wheel,["pcd","bolt_pattern"]);
        if (vehiclePcd && pcd) { if (normalizePcd(vehiclePcd) !== normalizePcd(pcd)) hasConflict = true; else pcdMatched = true; }
        const vehicleDiameter = numeric(vehicle.diameter);
        const productDiameter = numeric(valueAt(wheel,["diameter","rim_diameter"]));
        if (vehicleDiameter !== null && productDiameter !== null) { if (Math.abs(vehicleDiameter-productDiameter) > .1) hasConflict = true; else diameterMatched = true; }
        const vehicleWidth = numeric(vehicle.width);
        const productWidth = numeric(valueAt(wheel,["width","rim_width"]));
