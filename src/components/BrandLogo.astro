      <path fill-rule="evenodd" d="M200 8 L208 0 L232 0 L240 8 L240 24 L233 30 L240 54 L229 54 L223 32 L210 32 L210 54 L200 54 Z M210 9 L229 9 L231 11 L231 21 L229 23 L210 23 Z" />
