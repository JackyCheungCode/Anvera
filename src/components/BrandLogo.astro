  </defs>
  <g transform="scale(0.98) skewX(-14)">
    <polygon points="270,23.6 279,54 261,54" fill="#ff5a1f" />
    <g fill="#d8dbe0">
      <polygon points="16,0 24,0 40,54 29,54 20,23.6 11,54 0,54" />
