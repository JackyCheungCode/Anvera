---
import { TextInputControl } from "../carbon/Controls";
interface Props {
  id: string;
  name: string;
  label: string;
  type?: "text" | "email" | "tel" | "number" | "url" | "search" | "password";
  value?: string;
  placeholder?: string;
  required?: boolean;
  autocomplete?: string;
  helpText?: string;
  className?: string;
  readOnly?: boolean;
}
const props = Astro.props;
---
<TextInputControl {...props} />
