---
interface Props {
  id: string;
  name: string;
  label: string;
  options: Array<{ value: string; label: string }>;
  value?: string;
  placeholder?: string;
  required?: boolean;
  helpText?: string;
}
const { id, name, label, options, value = "", placeholder = "Select an option", required = false, helpText } = Astro.props;
const selected = options.find((option) => option.value === value);
---
<div class="cds-field cds-dropdown" id={id} data-cds-dropdown data-required={required ? "true" : "false"}>
  <span class="cds-label" id={`${id}-label`}>{label}{required && <span aria-hidden="true"> *</span>}</span>
  <input type="hidden" name={name} value={value} data-dropdown-value />
  <button
    class="cds-combobox-trigger"
    type="button"
    aria-labelledby={`${id}-label ${id}-value`}
    aria-haspopup="listbox"
    aria-expanded="false"
    aria-controls={`${id}-listbox`}
    data-dropdown-trigger
  >
    <span id={`${id}-value`} data-dropdown-label>{selected?.label ?? placeholder}</span>
    <span aria-hidden="true" class="cds-combobox-chevron">⌄</span>
  </button>
  <div class="cds-listbox" id={`${id}-listbox`} role="listbox" aria-labelledby={`${id}-label`} hidden>
    {options.map((option) => (
      <button
        class="cds-listbox-option"
        type="button"
        role="option"
        data-value={option.value}
        aria-selected={option.value === value ? "true" : "false"}
      >
        {option.label}
      </button>
    ))}
  </div>
  {helpText && <span class="cds-helper">{helpText}</span>}
  <span class="cds-helper cds-dropdown-error" data-dropdown-error hidden>Please select an option.</span>
</div>
<script>
  document.querySelectorAll<HTMLElement>("[data-cds-dropdown]").forEach((root) => {
    const trigger = root.querySelector<HTMLButtonElement>("[data-dropdown-trigger]");
    const listbox = root.querySelector<HTMLDivElement>("[role=listbox]");
    const hiddenInput = root.querySelector<HTMLInputElement>("[data-dropdown-value]");
    const label = root.querySelector<HTMLSpanElement>("[data-dropdown-label]");
    const error = root.querySelector<HTMLElement>("[data-dropdown-error]");
    const options = Array.from(root.querySelectorAll<HTMLButtonElement>("[role=option]"));
    if (!trigger || !listbox || !hiddenInput || !label) return;

    const close = () => {
      listbox.hidden = true;
      trigger.setAttribute("aria-expanded", "false");
      root.classList.remove("is-open");
    };
    const open = (focusFirst = false) => {
      listbox.hidden = false;
      trigger.setAttribute("aria-expanded", "true");
      root.classList.add("is-open");
      if (focusFirst) options[0]?.focus();
    };
    const choose = (option) => {
      hiddenInput.value = option.dataset.value || "";
      label.textContent = option.textContent?.trim() || "";
      options.forEach((item) => item.setAttribute("aria-selected", item === option ? "true" : "false"));
      if (error) error.hidden = true;
      root.classList.remove("is-invalid");
      close();
      trigger.focus();
      hiddenInput.dispatchEvent(new Event("change", { bubbles: true }));
    };

    trigger.addEventListener("click", () => {
      if (trigger.getAttribute("aria-expanded") === "true") close();
      else open();
    });
    trigger.addEventListener("keydown", (event: KeyboardEvent) => {
      if (event.key === "ArrowDown" || event.key === "Enter" || event.key === " ") {
        event.preventDefault();
        open(true);
      }
    });
    options.forEach((option: HTMLButtonElement, index: number) => {
      option.addEventListener("click", () => choose(option));
      option.addEventListener("keydown", (event: KeyboardEvent) => {
        if (event.key === "ArrowDown") {
          event.preventDefault();
          options[(index + 1) % options.length]?.focus();
        } else if (event.key === "ArrowUp") {
          event.preventDefault();
          options[(index - 1 + options.length) % options.length]?.focus();
        } else if (event.key === "Home") {
          event.preventDefault();
          options[0]?.focus();
        } else if (event.key === "End") {
          event.preventDefault();
          options[options.length - 1]?.focus();
        } else if (event.key === "Escape") {
          event.preventDefault();
          close();
          trigger.focus();
        }
      });
    });
    document.addEventListener("click", (event: MouseEvent) => {
      if (event.target instanceof Node && !root.contains(event.target)) close();
    });
    const form = root.closest<HTMLFormElement>("form");
    form?.addEventListener("submit", (event: SubmitEvent) => {
      if (root.dataset.required === "true" && !hiddenInput.value) {
        event.preventDefault();
        root.classList.add("is-invalid");
        if (error) error.hidden = false;
        trigger.focus();
      }
    });
  });
</script>
