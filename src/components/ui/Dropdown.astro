---
import { DropdownControl } from "../carbon/Controls";
interface Props {
  id: string;
  name: string;
  label: string;
  options: Array<{ value: string; label: string }>;
  value?: string;
  placeholder?: string;
  required?: boolean;
  helpText?: string;
}
const props = Astro.props;
---
<DropdownControl client:load {...props} />
