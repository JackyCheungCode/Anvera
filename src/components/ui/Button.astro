---
import { ButtonControl } from "../carbon/Controls";
interface Props {
  href?: string;
  variant?: "primary" | "secondary" | "dark" | "ghost";
  type?: "button" | "submit" | "reset";
  disabled?: boolean;
  id?: string;
  className?: string;
  filterKey?: string;
  ariaPressed?: boolean;
  ariaExpanded?: boolean;
  productKey?: string;
}
const { href, variant = "primary", type = "button", disabled = false, id, className, filterKey, ariaPressed, ariaExpanded, productKey } = Astro.props;
---
<ButtonControl id={id} className={className} filterKey={filterKey} ariaPressed={ariaPressed} ariaExpanded={ariaExpanded} productKey={productKey} href={href} variant={variant} type={type} disabled={disabled}>
  <slot />
</ButtonControl>
