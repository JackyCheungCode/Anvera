---
interface Props {
  href?: string;
  variant?: "primary" | "secondary" | "dark";
  type?: "button" | "submit" | "reset";
  disabled?: boolean;
}
const { href, variant = "primary", type = "button", disabled = false } = Astro.props;
const className = `cds-btn cds-btn--${variant}`;
---
{href ? (
  <a class={className} href={href} aria-disabled={disabled ? "true" : undefined}>
    <slot />
  </a>
) : (
  <button class={className} type={type} disabled={disabled}>
    <slot />
  </button>
)}
