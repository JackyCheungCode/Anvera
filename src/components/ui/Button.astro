---
import { ButtonControl } from "../carbon/Controls";
interface Props {
  href?: string;
  variant?: "primary" | "secondary" | "dark";
  type?: "button" | "submit" | "reset";
  disabled?: boolean;
}
const { href, variant = "primary", type = "button", disabled = false } = Astro.props;
---
<ButtonControl href={href} variant={variant} type={type} disabled={disabled}>
  <slot />
</ButtonControl>
