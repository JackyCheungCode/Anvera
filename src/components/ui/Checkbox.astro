---
interface Props {
  id: string;
  name: string;
  value?: string;
  checked?: boolean;
  required?: boolean;
}
const { id, name, value = "on", checked = false, required = false } = Astro.props;
---
<label class="cds-checkbox" for={id}>
  <input id={id} name={name} type="checkbox" value={value} checked={checked} required={required} />
  <span class="cds-checkbox-box" aria-hidden="true"></span>
  <span class="cds-checkbox-label"><slot /></span>
</label>
