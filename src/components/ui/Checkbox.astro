---
import { CheckboxControl } from "../bmw-m/SharedControls";
interface Props {
  id: string;
  name: string;
  value?: string;
  checked?: boolean;
  required?: boolean;
}
const { id, name, value = "on", checked = false, required = false } = Astro.props;
---
<CheckboxControl id={id} name={name} value={value} checked={checked} required={required}>
  <slot />
</CheckboxControl>
